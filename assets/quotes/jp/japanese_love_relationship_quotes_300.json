[
  {
    "id": 1,
    "category": "愛と関係",
    "text": "愛は、相手を変えることより、理解しようとすることから始まる。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "愛と関係",
    "text": "大切な人には、思っているだけでなく言葉で伝えよう。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "愛と関係",
    "text": "信頼は一度の約束ではなく、日々の小さな誠実さで育つ。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "愛と関係",
    "text": "愛するとは、相手の自由を尊重しながらそばにいること。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "愛と関係",
    "text": "心を開く勇気が、深いつながりの入り口になる。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "愛と関係",
    "text": "優しい言葉は、長く心に残る贈り物になる。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "愛と関係",
    "text": "本当の親しさは、沈黙の時間も安心して分かち合えること。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "愛と関係",
    "text": "相手の話を最後まで聞くことも、愛情の表現だ。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "愛と関係",
    "text": "関係を育てるのは、特別な日より何気ない日の思いやり。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "愛と関係",
    "text": "愛は完璧な人を探すことではなく、一緒に成長すること。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "愛と関係",
    "text": "違いを認め合うと、二人の世界はもっと広くなる。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "愛と関係",
    "text": "信頼は急いで築けない。小さな約束を守ることから始まる。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "愛と関係",
    "text": "好きという気持ちは、相手を大切にする行動で深まっていく。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "愛と関係",
    "text": "近くにいる人ほど、感謝と敬意を忘れずにいたい。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "愛と関係",
    "text": "愛情は、相手の弱さを責めずに受け止める心にも表れる。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "愛と関係",
    "text": "よい関係には、正しさを競うより理解し合う姿勢が必要だ。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "愛と関係",
    "text": "思いやりは、相手の立場から世界を見ようとすること。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "愛と関係",
    "text": "愛は束縛ではなく、安心して自分らしくいられる場所をつくる。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "愛と関係",
    "text": "謝る勇気と許し合う余裕が、関係をしなやかにする。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "愛と関係",
    "text": "本音を伝えるときこそ、相手の心を傷つけない言葉を選ぼう。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "愛と関係",
    "text": "愛する人の夢を応援することは、その人の未来を信じること。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "愛と関係",
    "text": "一緒に笑える関係は、日々の疲れをやわらげてくれる。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "愛と関係",
    "text": "心の距離は、同じ場所にいる時間より、向き合う姿勢で縮まる。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "愛と関係",
    "text": "愛は、相手の幸せを自分の喜びとして感じる瞬間に育つ。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "愛と関係",
    "text": "相手を尊重することは、自分自身を尊重することにもつながる。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "愛と関係",
    "text": "大切な関係は、勝ち負けではなく歩み寄りで守られる。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "愛と関係",
    "text": "言葉にしなくても伝わることはある。でも言葉にすれば、もっと伝わる。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "愛と関係",
    "text": "長く続く愛は、情熱だけでなく日々の気遣いに支えられる。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "愛と関係",
    "text": "相手の気持ちを決めつけず、まず尋ねてみよう。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "愛と関係",
    "text": "愛は、相手を所有することではなく、共にいる喜びを選ぶこと。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "愛と関係",
    "text": "小さな約束を守る人は、大きな信頼を育てていく。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "愛と関係",
    "text": "人を大切にするとは、その人の時間と気持ちを大切にすること。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "愛と関係",
    "text": "心地よい関係には、近づく勇気と一人の時間を尊重する余白がある。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "愛と関係",
    "text": "相手の話に耳を傾けるとき、心もそばにいる。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "愛と関係",
    "text": "愛情は、見返りを数えるより、思いやりを分かち合うことで深まる。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "愛と関係",
    "text": "関係を守るために必要なのは、我慢だけでなく率直な対話だ。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "愛と関係",
    "text": "誰かを愛する前に、自分の心も大切に扱おう。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "愛と関係",
    "text": "本当のつながりは、弱さを見せても尊重される安心から生まれる。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "愛と関係",
    "text": "一緒に過ごした時間より、互いにどう向き合ったかが記憶に残る。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "愛と関係",
    "text": "愛は大きな言葉より、疲れた日に差し出す小さな手に宿る。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "愛と関係",
    "text": "信頼は、疑いを責めることではなく、不安を話し合うことで育つ。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "愛と関係",
    "text": "相手の喜びを素直に喜べることは、愛の美しい形の一つ。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "愛と関係",
    "text": "親しい人にも礼儀を忘れないことが、関係を長く温める。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "愛と関係",
    "text": "愛は、違いを消すことではなく、違いの中に共通の道を見つけること。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "愛と関係",
    "text": "気持ちがすれ違ったとき、相手を敵にせず問題を一緒に見つめよう。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "愛と関係",
    "text": "一言の「大丈夫？」が、孤独な心を支えることがある。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "愛と関係",
    "text": "愛する人の話を覚えていることは、関心を行動で示すこと。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "愛と関係",
    "text": "関係の深さは、意見が違うときの敬意に表れる。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "愛と関係",
    "text": "心を通わせるには、話すことと同じくらい聴くことが大切だ。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "愛と関係",
    "text": "愛は、毎日相手を選び直す小さな決意でもある。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "愛と関係",
    "text": "誰かと長く歩くには、同じ速さより互いの歩幅を尊重すること。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "愛と関係",
    "text": "優しさは弱さではない。関係を育てる静かな強さだ。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "愛と関係",
    "text": "相手の欠点だけを見つめると、魅力まで見えなくなってしまう。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "愛と関係",
    "text": "大切な人との時間は、画面を閉じて目を合わせることから豊かになる。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "愛と関係",
    "text": "愛は、相手が自分と違う人間であることを忘れないこと。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "愛と関係",
    "text": "心からの謝罪は、言い訳よりも相手の痛みに目を向ける。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "愛と関係",
    "text": "関係を長続きさせるのは、完璧さより修復しようとする意志だ。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "愛と関係",
    "text": "相手を理解する努力は、愛情を日常に根づかせる。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "愛と関係",
    "text": "信頼できる人とは、いつも同意する人ではなく、誠実に話せる人。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "愛と関係",
    "text": "愛は、自由を奪わず、安心して戻ってこられる場所をつくる。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "愛と関係",
    "text": "小さな気遣いを当たり前にしないことが、感謝を育てる。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "愛と関係",
    "text": "相手の沈黙には理由があるかもしれない。決めつけずに待とう。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "愛と関係",
    "text": "親密さは、何でも知ることではなく、知ろうとし続けること。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "愛と関係",
    "text": "愛する人を支えることと、その人の問題をすべて背負うことは違う。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "愛と関係",
    "text": "心地よい関係は、互いに「嫌だ」と言える安心も持っている。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "愛と関係",
    "text": "言葉の温度を少し上げるだけで、会話の景色は変わる。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "愛と関係",
    "text": "愛は、相手を自分の理想に合わせることをやめたときに深まる。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "愛と関係",
    "text": "信頼は、見ていないところでも誠実であることから生まれる。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "愛と関係",
    "text": "二人の関係を育てるには、正解を探すより気持ちを確かめよう。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "愛と関係",
    "text": "思いやりは、相手が望む助け方を尋ねることから始まる。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "愛と関係",
    "text": "愛は、弱さを隠さなくてもよいと思える安心感。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "愛と関係",
    "text": "一緒にいる理由を、時々言葉にして伝えよう。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "愛と関係",
    "text": "関係は自然に続くものではなく、互いの手入れで育つもの。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "愛と関係",
    "text": "相手の過去を裁くより、今どんな人であろうとしているかを見よう。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "愛と関係",
    "text": "本当の親しさには、笑い合う時間と真剣に話す時間の両方がある。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "愛と関係",
    "text": "愛情は、相手の境界線を尊重することにも表れる。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "愛と関係",
    "text": "気持ちを伝えるときは、責める言葉より自分の感情を話そう。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "愛と関係",
    "text": "大切な人を失いたくないなら、そばにいる今を丁寧に扱おう。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "愛と関係",
    "text": "愛は、いつも同じ気持ちでいることではなく、変化を話し合うこと。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "愛と関係",
    "text": "人との縁は、近さだけでなく互いを尊重する距離によっても守られる。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "愛と関係",
    "text": "優しさを受け取ることも、与えることと同じくらい大切だ。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "愛と関係",
    "text": "相手の努力に気づいて伝えると、愛情は目に見える形になる。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "愛と関係",
    "text": "関係を深める質問は、相手を試すためではなく知るためにある。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "愛と関係",
    "text": "愛は、相手の成功を脅威ではなく喜びとして迎えること。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "愛と関係",
    "text": "大切な人との違いは、対立の種にも学びの扉にもなる。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "愛と関係",
    "text": "言い争いの最中でも、相手の尊厳を傷つけないことを忘れないで。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "愛と関係",
    "text": "安心できる関係では、沈黙も説明も無理なく選べる。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "愛と関係",
    "text": "愛は、相手の人生を代わりに生きることではない。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "愛と関係",
    "text": "一緒に成長する関係は、変わることを恐れず話し合える。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "愛と関係",
    "text": "相手の気持ちを尊重することは、自分の気持ちを消すことではない。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "愛と関係",
    "text": "心のこもった挨拶は、関係をつなぐ小さな糸になる。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "愛と関係",
    "text": "愛は、相手の存在を便利さではなく尊さで見ること。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "愛と関係",
    "text": "信頼を壊すのは一瞬でも、取り戻すには誠実な時間がいる。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "愛と関係",
    "text": "よい関係は、互いの違いを直すより理解することに力を使う。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "愛と関係",
    "text": "大切な人には、察してもらうことを期待する前に伝えてみよう。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "愛と関係",
    "text": "愛情は、相手の言葉だけでなく行動にも耳を傾けること。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "愛と関係",
    "text": "誰かを大切にするなら、その人の話を急いで結論づけないで。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "愛と関係",
    "text": "一緒にいるときに安心できることは、派手な言葉以上の贈り物。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "愛と関係",
    "text": "関係を育てるのは、正しさの証明より心の共有だ。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "愛と関係",
    "text": "愛は、相手の選択を尊重しながら自分の思いも伝えること。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "愛と関係",
    "text": "小さな誤解は、早めの対話で大きな距離になるのを防げる。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "愛と関係",
    "text": "相手の気持ちを想像しつつ、分からないことは素直に尋ねよう。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "愛と関係",
    "text": "愛情は、忙しい日にも相手を思い出す小さな行動に表れる。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "愛と関係",
    "text": "親しさに甘えず、ありがとうとごめんなさいを忘れないで。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "愛と関係",
    "text": "相手を変えようとする前に、自分の伝え方を見直してみよう。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "愛と関係",
    "text": "愛は、共にいることを義務ではなく喜びにしていく。",
    "language": "ja"
  },
  {
    "id": 107,
    "category": "愛と関係",
    "text": "信頼は、秘密を守ることと本音を話せることの両方で育つ。",
    "language": "ja"
  },
  {
    "id": 108,
    "category": "愛と関係",
    "text": "心が近づくのは、同じ意見のときだけではない。",
    "language": "ja"
  },
  {
    "id": 109,
    "category": "愛と関係",
    "text": "大切な関係には、楽しい思い出だけでなく難しい話をする勇気も必要だ。",
    "language": "ja"
  },
  {
    "id": 110,
    "category": "愛と関係",
    "text": "愛する人に自由を与えることは、信頼を形にすること。",
    "language": "ja"
  },
  {
    "id": 111,
    "category": "愛と関係",
    "text": "関係の中で自分を失わないことも、相手を大切にすることにつながる。",
    "language": "ja"
  },
  {
    "id": 112,
    "category": "愛と関係",
    "text": "言葉で勝っても、心が離れたら本当の意味での勝利ではない。",
    "language": "ja"
  },
  {
    "id": 113,
    "category": "愛と関係",
    "text": "相手の不完全さを認めることは、自分の不完全さにも優しくなること。",
    "language": "ja"
  },
  {
    "id": 114,
    "category": "愛と関係",
    "text": "愛は、毎日の小さな選択の中で静かに育っていく。",
    "language": "ja"
  },
  {
    "id": 115,
    "category": "愛と関係",
    "text": "二人の間に問題が起きたとき、誰が悪いかより何が必要かを考えよう。",
    "language": "ja"
  },
  {
    "id": 116,
    "category": "愛と関係",
    "text": "思いやりのある関係は、互いの疲れに気づき休む余地をつくる。",
    "language": "ja"
  },
  {
    "id": 117,
    "category": "愛と関係",
    "text": "相手の気持ちを軽く扱わないことが、信頼の土台になる。",
    "language": "ja"
  },
  {
    "id": 118,
    "category": "愛と関係",
    "text": "愛は、相手が話し終えるまで待つ忍耐にも表れる。",
    "language": "ja"
  },
  {
    "id": 119,
    "category": "愛と関係",
    "text": "親密さとは、相手をすべて知ったと思わず、何度でも出会い直すこと。",
    "language": "ja"
  },
  {
    "id": 120,
    "category": "愛と関係",
    "text": "誰かを愛していても、いつも同じ考えである必要はない。",
    "language": "ja"
  },
  {
    "id": 121,
    "category": "愛と関係",
    "text": "大切な人との約束には、時間を守ることも含まれている。",
    "language": "ja"
  },
  {
    "id": 122,
    "category": "愛と関係",
    "text": "愛情を伝える方法は一つではない。相手に届く形を探してみよう。",
    "language": "ja"
  },
  {
    "id": 123,
    "category": "愛と関係",
    "text": "関係を守るには、相手の言葉を自分の不安だけで解釈しないこと。",
    "language": "ja"
  },
  {
    "id": 124,
    "category": "愛と関係",
    "text": "心からの関心は、細かな変化に気づくまなざしに表れる。",
    "language": "ja"
  },
  {
    "id": 125,
    "category": "愛と関係",
    "text": "愛は、相手の弱さを秘密の武器にしないこと。",
    "language": "ja"
  },
  {
    "id": 126,
    "category": "愛と関係",
    "text": "信頼できる関係では、間違いを認めることが終わりではなく始まりになる。",
    "language": "ja"
  },
  {
    "id": 127,
    "category": "愛と関係",
    "text": "人を愛することは、その人の尊厳を日々選び続けること。",
    "language": "ja"
  },
  {
    "id": 128,
    "category": "愛と関係",
    "text": "二人の時間を守るために、忙しさにも境界線を引こう。",
    "language": "ja"
  },
  {
    "id": 129,
    "category": "愛と関係",
    "text": "相手の意見を聞くことは、必ず従うことではなく尊重すること。",
    "language": "ja"
  },
  {
    "id": 130,
    "category": "愛と関係",
    "text": "愛情は、相手が求めていない助言を控える優しさにもある。",
    "language": "ja"
  },
  {
    "id": 131,
    "category": "愛と関係",
    "text": "関係を深めるには、相手の良さを見つけて言葉にしよう。",
    "language": "ja"
  },
  {
    "id": 132,
    "category": "愛と関係",
    "text": "気持ちが伝わらないときは、愛がないと決める前に伝え方を変えてみよう。",
    "language": "ja"
  },
  {
    "id": 133,
    "category": "愛と関係",
    "text": "愛は、相手の幸せを願いながら、自分の幸せも大切にすること。",
    "language": "ja"
  },
  {
    "id": 134,
    "category": "愛と関係",
    "text": "安心できる人間関係は、無理に演じなくてもよい場所をつくる。",
    "language": "ja"
  },
  {
    "id": 135,
    "category": "愛と関係",
    "text": "謝罪の後に行動が変わると、信頼は少しずつ戻ってくる。",
    "language": "ja"
  },
  {
    "id": 136,
    "category": "愛と関係",
    "text": "相手を大切にするなら、その人の「ノー」も尊重しよう。",
    "language": "ja"
  },
  {
    "id": 137,
    "category": "愛と関係",
    "text": "関係の中で大事なのは、いつも近くにいることより誠実であること。",
    "language": "ja"
  },
  {
    "id": 138,
    "category": "愛と関係",
    "text": "愛は、相手の夢を笑わず、可能性を一緒に考えること。",
    "language": "ja"
  },
  {
    "id": 139,
    "category": "愛と関係",
    "text": "言葉にできない気持ちにも、焦らず向き合う時間を与えよう。",
    "language": "ja"
  },
  {
    "id": 140,
    "category": "愛と関係",
    "text": "長く続く関係は、何度でも話し合い、何度でも理解し直す。",
    "language": "ja"
  },
  {
    "id": 141,
    "category": "愛と関係",
    "text": "相手の幸せを願うことと、自分を犠牲にすることは同じではない。",
    "language": "ja"
  },
  {
    "id": 142,
    "category": "愛と関係",
    "text": "小さな不満を責めずに伝えると、関係を守る会話になる。",
    "language": "ja"
  },
  {
    "id": 143,
    "category": "愛と関係",
    "text": "愛は、相手を所有する願いではなく、共に歩む意志。",
    "language": "ja"
  },
  {
    "id": 144,
    "category": "愛と関係",
    "text": "信頼は、正直さと一貫した行動が重なって形になる。",
    "language": "ja"
  },
  {
    "id": 145,
    "category": "愛と関係",
    "text": "大切な人にこそ、丁寧な言葉を使おう。",
    "language": "ja"
  },
  {
    "id": 146,
    "category": "愛と関係",
    "text": "親しさは、相手の気持ちを決めつけない謙虚さで深まる。",
    "language": "ja"
  },
  {
    "id": 147,
    "category": "愛と関係",
    "text": "愛は、相手の心に安全な居場所をつくること。",
    "language": "ja"
  },
  {
    "id": 148,
    "category": "愛と関係",
    "text": "関係を育てるには、互いの努力を見えないものにしないこと。",
    "language": "ja"
  },
  {
    "id": 149,
    "category": "愛と関係",
    "text": "気持ちがすれ違っても、相手を理解したいという姿勢は残せる。",
    "language": "ja"
  },
  {
    "id": 150,
    "category": "愛と関係",
    "text": "相手の話を覚えていることは、あなたに関心があるという合図。",
    "language": "ja"
  },
  {
    "id": 151,
    "category": "愛と関係",
    "text": "愛情は、相手の欠点を見ないことではなく、全体を見ようとすること。",
    "language": "ja"
  },
  {
    "id": 152,
    "category": "愛と関係",
    "text": "互いに謝れる関係には、誇りよりつながりを大切にする強さがある。",
    "language": "ja"
  },
  {
    "id": 153,
    "category": "愛と関係",
    "text": "愛は、特別な言葉を待たず、日々の行動に見つけられる。",
    "language": "ja"
  },
  {
    "id": 154,
    "category": "愛と関係",
    "text": "誰かと長く関係を続けるには、感謝を習慣にすること。",
    "language": "ja"
  },
  {
    "id": 155,
    "category": "愛と関係",
    "text": "心を近づけるには、相手の話を評価する前に受け止めよう。",
    "language": "ja"
  },
  {
    "id": 156,
    "category": "愛と関係",
    "text": "相手の自由を信じることは、関係の中に余裕を生む。",
    "language": "ja"
  },
  {
    "id": 157,
    "category": "愛と関係",
    "text": "本当の愛情は、相手を小さくするのではなく、その人らしさを育てる。",
    "language": "ja"
  },
  {
    "id": 158,
    "category": "愛と関係",
    "text": "関係の安心は、いつも正しいことより、正直でいられることから生まれる。",
    "language": "ja"
  },
  {
    "id": 159,
    "category": "愛と関係",
    "text": "愛する人にも、自分にも、成長するための時間を与えよう。",
    "language": "ja"
  },
  {
    "id": 160,
    "category": "愛と関係",
    "text": "相手を大切にする気持ちは、忙しいときの態度にも表れる。",
    "language": "ja"
  },
  {
    "id": 161,
    "category": "愛と関係",
    "text": "一緒に過ごす日々を、慣れだけで通り過ぎないようにしよう。",
    "language": "ja"
  },
  {
    "id": 162,
    "category": "愛と関係",
    "text": "愛は、相手の喜びを祝福し、悲しみには寄り添うこと。",
    "language": "ja"
  },
  {
    "id": 163,
    "category": "愛と関係",
    "text": "人とのつながりは、言葉を交わすたびに少しずつ形づくられる。",
    "language": "ja"
  },
  {
    "id": 164,
    "category": "愛と関係",
    "text": "思いやりは、相手の立場を想像するだけでなく、実際に尋ねること。",
    "language": "ja"
  },
  {
    "id": 165,
    "category": "愛と関係",
    "text": "関係を修復するには、過去を責め続けるより未来の行動を決めよう。",
    "language": "ja"
  },
  {
    "id": 166,
    "category": "愛と関係",
    "text": "愛は、完璧な理解ではなく、理解しようとする努力に宿る。",
    "language": "ja"
  },
  {
    "id": 167,
    "category": "愛と関係",
    "text": "心が近い人にも、感謝を言葉にして届けよう。",
    "language": "ja"
  },
  {
    "id": 168,
    "category": "愛と関係",
    "text": "相手の感情を否定せず、まずその人にとっての現実として聞こう。",
    "language": "ja"
  },
  {
    "id": 169,
    "category": "愛と関係",
    "text": "信頼は、言葉と行動が同じ方向を向くときに育つ。",
    "language": "ja"
  },
  {
    "id": 170,
    "category": "愛と関係",
    "text": "愛情は、相手のために何かをすることだけでなく、共に休むことにもある。",
    "language": "ja"
  },
  {
    "id": 171,
    "category": "愛と関係",
    "text": "違う意見を持ちながら尊重し合える関係は、しなやかで強い。",
    "language": "ja"
  },
  {
    "id": 172,
    "category": "愛と関係",
    "text": "相手の心を大切にするなら、冗談にも思いやりを忘れないで。",
    "language": "ja"
  },
  {
    "id": 173,
    "category": "愛と関係",
    "text": "愛は、困難がないことではなく、困難を一緒に扱う姿勢。",
    "language": "ja"
  },
  {
    "id": 174,
    "category": "愛と関係",
    "text": "相手を理解するには、自分の思い込みを一度脇に置こう。",
    "language": "ja"
  },
  {
    "id": 175,
    "category": "愛と関係",
    "text": "関係に必要なのは、いつも同じ気持ちでいることより、変化を伝え合うこと。",
    "language": "ja"
  },
  {
    "id": 176,
    "category": "愛と関係",
    "text": "誰かのそばにいるとき、解決策より共感が必要なこともある。",
    "language": "ja"
  },
  {
    "id": 177,
    "category": "愛と関係",
    "text": "愛は、相手の人生を尊重しながら自分の人生も歩むこと。",
    "language": "ja"
  },
  {
    "id": 178,
    "category": "愛と関係",
    "text": "小さな気遣いは、言葉にできない愛情を伝えてくれる。",
    "language": "ja"
  },
  {
    "id": 179,
    "category": "愛と関係",
    "text": "親しい間柄でも、相手の時間を自分のものと思わないで。",
    "language": "ja"
  },
  {
    "id": 180,
    "category": "愛と関係",
    "text": "信頼を育てるのは、約束を守ることと、守れないときに正直に話すこと。",
    "language": "ja"
  },
  {
    "id": 181,
    "category": "愛と関係",
    "text": "愛は、相手の存在を当たり前にしない心から育つ。",
    "language": "ja"
  },
  {
    "id": 182,
    "category": "愛と関係",
    "text": "気持ちを伝えるときは、勝つためでなく分かり合うために話そう。",
    "language": "ja"
  },
  {
    "id": 183,
    "category": "愛と関係",
    "text": "大切な関係は、互いに安心して変化できる場所である。",
    "language": "ja"
  },
  {
    "id": 184,
    "category": "愛と関係",
    "text": "愛情は、相手が困っているときに何を望んでいるか尋ねることにも表れる。",
    "language": "ja"
  },
  {
    "id": 185,
    "category": "愛と関係",
    "text": "人を大切にするなら、相手の話を途中で奪わないようにしよう。",
    "language": "ja"
  },
  {
    "id": 186,
    "category": "愛と関係",
    "text": "愛は、近づくことと尊重して距離を保つことの調和。",
    "language": "ja"
  },
  {
    "id": 187,
    "category": "愛と関係",
    "text": "関係の中で感謝を伝えると、見えにくい努力が光を持つ。",
    "language": "ja"
  },
  {
    "id": 188,
    "category": "愛と関係",
    "text": "相手を信じることは、疑問を持たないことではなく、誠実に確かめること。",
    "language": "ja"
  },
  {
    "id": 189,
    "category": "愛と関係",
    "text": "愛は、相手の過ちを責めるだけでなく、改善の道を一緒に探すこと。",
    "language": "ja"
  },
  {
    "id": 190,
    "category": "愛と関係",
    "text": "心のつながりは、弱さを見せたときの扱い方で深まる。",
    "language": "ja"
  },
  {
    "id": 191,
    "category": "愛と関係",
    "text": "愛情を長く保つには、相手を知ったつもりにならないこと。",
    "language": "ja"
  },
  {
    "id": 192,
    "category": "愛と関係",
    "text": "互いの幸せを応援できる関係は、二人の世界を広げる。",
    "language": "ja"
  },
  {
    "id": 193,
    "category": "愛と関係",
    "text": "大切な人には、結果だけでなく努力にも目を向けよう。",
    "language": "ja"
  },
  {
    "id": 194,
    "category": "愛と関係",
    "text": "関係を守る言葉は、相手を追い詰めず、対話へ招く言葉。",
    "language": "ja"
  },
  {
    "id": 195,
    "category": "愛と関係",
    "text": "愛は、相手の人生に敬意を払いながら共に思い出をつくること。",
    "language": "ja"
  },
  {
    "id": 196,
    "category": "愛と関係",
    "text": "気持ちを伝えるのが難しいときは、まず正直に難しいと伝えよう。",
    "language": "ja"
  },
  {
    "id": 197,
    "category": "愛と関係",
    "text": "信頼は、疑いを隠すことではなく、不安を丁寧に話せることで育つ。",
    "language": "ja"
  },
  {
    "id": 198,
    "category": "愛と関係",
    "text": "愛することは、相手を完全に理解したと主張することではない。",
    "language": "ja"
  },
  {
    "id": 199,
    "category": "愛と関係",
    "text": "互いに休める関係は、頑張り続けなくても続いていく。",
    "language": "ja"
  },
  {
    "id": 200,
    "category": "愛と関係",
    "text": "相手の存在に慣れても、その人の価値まで見慣れないで。",
    "language": "ja"
  },
  {
    "id": 201,
    "category": "愛と関係",
    "text": "愛情は、相手の小さな変化に気づき、気にかけること。",
    "language": "ja"
  },
  {
    "id": 202,
    "category": "愛と関係",
    "text": "関係の中で自分の気持ちを大切にすることは、わがままではない。",
    "language": "ja"
  },
  {
    "id": 203,
    "category": "愛と関係",
    "text": "愛は、言葉と沈黙の両方で相手に寄り添うこと。",
    "language": "ja"
  },
  {
    "id": 204,
    "category": "愛と関係",
    "text": "相手の喜びを一緒に祝うと、信頼と親しさが深まる。",
    "language": "ja"
  },
  {
    "id": 205,
    "category": "愛と関係",
    "text": "大切な人と意見が違うときこそ、敬意を忘れないで。",
    "language": "ja"
  },
  {
    "id": 206,
    "category": "愛と関係",
    "text": "関係を長く育てるには、謝罪と感謝を惜しまないこと。",
    "language": "ja"
  },
  {
    "id": 207,
    "category": "愛と関係",
    "text": "愛は、相手の心を決めつけず、何度でも聞き直すこと。",
    "language": "ja"
  },
  {
    "id": 208,
    "category": "愛と関係",
    "text": "本当のつながりは、互いを自由にしながら支え合う。",
    "language": "ja"
  },
  {
    "id": 209,
    "category": "愛と関係",
    "text": "相手を大切にする小さな行動が、安心できる未来をつくる。",
    "language": "ja"
  },
  {
    "id": 210,
    "category": "愛と関係",
    "text": "愛情は、相手を変える力ではなく、共に成長する力。",
    "language": "ja"
  },
  {
    "id": 211,
    "category": "愛と関係",
    "text": "一緒にいることを選ぶなら、その時間に心を向けよう。",
    "language": "ja"
  },
  {
    "id": 212,
    "category": "愛と関係",
    "text": "信頼は、見えない場所での誠実さにも支えられている。",
    "language": "ja"
  },
  {
    "id": 213,
    "category": "愛と関係",
    "text": "愛は、相手の尊厳を守りながら本音を伝えること。",
    "language": "ja"
  },
  {
    "id": 214,
    "category": "愛と関係",
    "text": "気持ちのすれ違いは、対話を諦めないことで新しい理解に変わる。",
    "language": "ja"
  },
  {
    "id": 215,
    "category": "愛と関係",
    "text": "相手の優しさを受け取ったら、素直にありがとうと言おう。",
    "language": "ja"
  },
  {
    "id": 216,
    "category": "愛と関係",
    "text": "関係は、相手を理解する努力と自分を伝える勇気で深まる。",
    "language": "ja"
  },
  {
    "id": 217,
    "category": "愛と関係",
    "text": "愛する人にも、自分にも、間違いから学び直す余地を残そう。",
    "language": "ja"
  },
  {
    "id": 218,
    "category": "愛と関係",
    "text": "思いやりのある一言は、心の中の距離を縮める。",
    "language": "ja"
  },
  {
    "id": 219,
    "category": "愛と関係",
    "text": "愛は、相手の幸せを願いながら、互いの違いを大切にすること。",
    "language": "ja"
  },
  {
    "id": 220,
    "category": "愛と関係",
    "text": "今日の小さな対話が、明日の大きな信頼につながる。",
    "language": "ja"
  },
  {
    "id": 221,
    "category": "愛と関係",
    "text": "大切な人を思う気持ちは、行動にしてこそ届きやすくなる。",
    "language": "ja"
  },
  {
    "id": 222,
    "category": "愛と関係",
    "text": "愛は、相手の気持ちを尊重し、自分の気持ちにも誠実でいること。",
    "language": "ja"
  },
  {
    "id": 223,
    "category": "愛と関係",
    "text": "関係を育てる一歩は、相手を変える要求より自分からの理解。",
    "language": "ja"
  },
  {
    "id": 224,
    "category": "愛と関係",
    "text": "一緒に笑い、真剣に話し、必要なときは休む。それも愛の形。",
    "language": "ja"
  },
  {
    "id": 225,
    "category": "愛と関係",
    "text": "愛情は、相手を自由にしながら帰る場所を共につくること。",
    "language": "ja"
  },
  {
    "id": 226,
    "category": "愛と関係",
    "text": "人との縁を大切にするなら、日々の小さな約束を守ろう。",
    "language": "ja"
  },
  {
    "id": 227,
    "category": "愛と関係",
    "text": "相手の心に寄り添うには、正解を急がず、まず隣に座ろう。",
    "language": "ja"
  },
  {
    "id": 228,
    "category": "愛と関係",
    "text": "愛は、相手を完璧にすることではなく、その人らしさを尊重すること。",
    "language": "ja"
  },
  {
    "id": 229,
    "category": "愛と関係",
    "text": "心が通う関係は、互いに学び続ける姿勢から生まれる。",
    "language": "ja"
  },
  {
    "id": 230,
    "category": "愛と関係",
    "text": "大切な人への愛情は、忙しい日にも丁寧な態度で示せる。",
    "language": "ja"
  },
  {
    "id": 231,
    "category": "愛と関係",
    "text": "愛は、二人が同じ人になることではなく、違うまま一緒に歩くこと。",
    "language": "ja"
  },
  {
    "id": 232,
    "category": "愛と関係",
    "text": "相手の話に耳を傾けることは、その人の世界を大切にすること。",
    "language": "ja"
  },
  {
    "id": 233,
    "category": "愛と関係",
    "text": "信頼は、何度も選ぶ誠実さによって深くなる。",
    "language": "ja"
  },
  {
    "id": 234,
    "category": "愛と関係",
    "text": "関係の中に笑顔と正直さがあれば、困難にも向き合いやすくなる。",
    "language": "ja"
  },
  {
    "id": 235,
    "category": "愛と関係",
    "text": "愛は、相手の気持ちを軽く扱わず、共に考えること。",
