[
  {
    "id": 1,
    "category": "夢を描く",
    "text": "夢は、まだ見ぬ自分に出会うための地図になる。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "夢を描く",
    "text": "心に描いた景色は、最初の一歩を踏み出す力になる。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "夢を描く",
    "text": "夢を持つことは、未来に問いかけることだ。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "夢を描く",
    "text": "大きな夢も、小さな願いから始まっていく。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "夢を描く",
    "text": "夢は遠くにあっても、今日の選択に影響を与えられる。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "夢を描く",
    "text": "自分の夢を言葉にすると、進む方向が少しずつ見えてくる。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "夢を描く",
    "text": "夢を描く自由は、誰にも奪えない。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "夢を描く",
    "text": "まだ形のない夢にも、育つ可能性が宿っている。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "夢を描く",
    "text": "夢を持つ人の目には、日常の中にも道が見つかる。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "夢を描く",
    "text": "未来を思い描くことは、今を変える準備になる。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "夢を描く",
    "text": "夢は現実から逃げる場所ではなく、現実を動かす出発点だ。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "夢を描く",
    "text": "夢の大きさより、そこへ向かう気持ちを大切にしよう。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "夢を描く",
    "text": "誰かの夢をまねるより、自分の心が動くものを探そう。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "夢を描く",
    "text": "夢を忘れそうな日は、なぜ始めたのかを思い出そう。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "夢を描く",
    "text": "夢は一度決めたら変えてはいけないものではない。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "夢を描く",
    "text": "心がわくわくする方向に、未来のヒントが隠れている。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "夢を描く",
    "text": "夢を語ることは、自分の可能性を認めることでもある。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "夢を描く",
    "text": "まだ届かない場所を想像できるなら、歩き始める理由はある。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "夢を描く",
    "text": "夢は遠い星のようでも、歩く道を照らしてくれる。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "夢を描く",
    "text": "自分の望みを知ることが、人生の舵を握る第一歩だ。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "行動と一歩",
    "text": "夢に近づく方法は、今日できる小さなことを始めることだ。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "行動と一歩",
    "text": "完璧な準備を待つより、不完全でも一歩進もう。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "行動と一歩",
    "text": "始める勇気が、才能を育てる場所をつくる。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "行動と一歩",
    "text": "小さな行動は、止まっていた未来を動かす。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "行動と一歩",
    "text": "大きな変化は、目立たない一歩から生まれる。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "行動と一歩",
    "text": "いつかやるという言葉を、今日の行動に変えてみよう。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "行動と一歩",
    "text": "一歩目が遅くても、歩き続ければ景色は変わる。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "行動と一歩",
    "text": "迷いが消えるのを待たず、迷いながら進んでもいい。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "行動と一歩",
    "text": "やる気が出るのを待つより、少し動いてみよう。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "行動と一歩",
    "text": "行動した経験は、考えているだけでは得られない。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "行動と一歩",
    "text": "小さく始めることは、夢を小さくすることではない。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "行動と一歩",
    "text": "今日の十分間が、未来の大きな自信につながる。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "行動と一歩",
    "text": "一度に全部変えなくても、ひとつ始めればいい。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "行動と一歩",
    "text": "夢への道は、思いついた日ではなく動いた日から始まる。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "行動と一歩",
    "text": "最初の一歩に必要なのは、確信よりも好奇心だ。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "行動と一歩",
    "text": "遠くを見ながら、足元の一歩をおろそかにしない。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "行動と一歩",
    "text": "動き出せば、頭の中だけでは見えなかった道が現れる。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "行動と一歩",
    "text": "小さな挑戦を重ねる人は、大きな機会にも備えられる。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "行動と一歩",
    "text": "行動は、不安を消す魔法ではなく向き合う力になる。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "行動と一歩",
    "text": "今日できることを一つ終えれば、明日は少し近づく。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "努力と継続",
    "text": "続ける力は、特別な才能を少しずつ追い越していく。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "努力と継続",
    "text": "毎日の小さな努力が、いつか大きな差になる。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "努力と継続",
    "text": "成長は一晩では起きないが、毎日の積み重ねに宿る。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "努力と継続",
    "text": "進歩が見えない日にも、努力は土の下で根を伸ばしている。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "努力と継続",
    "text": "続けることは、未来の自分への贈り物だ。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "努力と継続",
    "text": "短い時間でも、積み重ねれば確かな力になる。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "努力と継続",
    "text": "昨日より少し前へ進むことを、軽く見ないでいよう。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "努力と継続",
    "text": "努力は必ず望んだ形で返るとは限らないが、自分を育てる。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "努力と継続",
    "text": "休みながら続けることも、立派な継続だ。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "努力と継続",
    "text": "小さな習慣は、大きな夢を支える土台になる。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "努力と継続",
    "text": "結果を急がず、今日の練習に集中しよう。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "努力と継続",
    "text": "毎日完璧でなくても、戻ってくることに意味がある。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "努力と継続",
    "text": "積み重ねた時間は、簡単には消えない力になる。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "努力と継続",
    "text": "続ける人は、才能だけでは見えない景色にたどり着く。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "努力と継続",
    "text": "少しずつ進む日々も、夢へ向かう確かな道だ。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "努力と継続",
    "text": "努力の価値は、誰かに見られた回数では決まらない。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "努力と継続",
    "text": "昨日の自分を超える挑戦を、今日も小さく続けよう。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "努力と継続",
    "text": "焦らず続ける人には、時間が味方になることがある。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "努力と継続",
    "text": "毎日の一歩は小さくても、向かう方向が未来を変える。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "努力と継続",
    "text": "続ける工夫を見つけることも、努力の一部だ。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "自信と可能性",
    "text": "自分を信じることは、まだ知らない力に機会を与えることだ。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "自信と可能性",
    "text": "今できないことは、永遠にできないことを意味しない。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "自信と可能性",
    "text": "可能性は、挑戦する前から決まっているわけではない。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "自信と可能性",
    "text": "自分の歩幅で進むことに、恥じる理由はない。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "自信と可能性",
    "text": "誰かより遅くても、自分の道を進む価値は変わらない。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "自信と可能性",
    "text": "自信は最初からあるものではなく、行動の中で育つ。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "自信と可能性",
    "text": "自分の弱さを知ることは、強さを育てる始まりになる。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "自信と可能性",
    "text": "過去の失敗だけで、未来の自分を決めつけないでいよう。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "自信と可能性",
    "text": "自分にできることを一つずつ増やせば、世界は広がる。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "自信と可能性",
    "text": "他人の評価より、自分が大切にしたい理由を忘れない。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "自信と可能性",
    "text": "自分の可能性を疑う日にも、挑戦する権利は残っている。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "自信と可能性",
    "text": "まだ完成していない自分にも、誇れる一歩がある。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "自信と可能性",
    "text": "自分を信じるとは、失敗しないと思うことではない。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "自信と可能性",
    "text": "小さな成功を認めることが、次の勇気をつくる。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "自信と可能性",
    "text": "自分の価値は、夢がかなう速さでは決まらない。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "自信と可能性",
    "text": "誰かの輝きは、あなたの光を消すものではない。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "自信と可能性",
    "text": "成長途中の自分に、完成形の基準を押しつけないでいよう。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "自信と可能性",
    "text": "自分の力を試す機会は、自分でつくることもできる。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "自信と可能性",
    "text": "できるかどうかを決める前に、試してみる余地を残そう。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "自信と可能性",
    "text": "自分に期待することは、未来を信じる小さな行為だ。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "失敗と挑戦",
    "text": "失敗は夢の終わりではなく、方法を見直す合図になる。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "失敗と挑戦",
    "text": "挑戦した跡は、何もしなかった日には残らない。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "失敗と挑戦",
    "text": "うまくいかなかった経験も、次の選択を賢くしてくれる。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "失敗と挑戦",
    "text": "失敗を恐れて立ち止まるより、学びながら進もう。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "失敗と挑戦",
    "text": "挑戦の価値は、成功したかどうかだけでは測れない。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "失敗と挑戦",
    "text": "遠回りで得た知恵が、あとで道を照らすこともある。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "失敗と挑戦",
    "text": "一度の失敗で、自分の可能性に終止符を打たない。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "失敗と挑戦",
    "text": "うまくいかない日は、やり方を変えるきっかけにできる。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "失敗と挑戦",
    "text": "勇気とは、怖さがなくなることではなく進むことだ。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "失敗と挑戦",
    "text": "失敗から学べる人は、経験を未来の力に変えられる。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "失敗と挑戦",
    "text": "挑戦しなかった後悔より、挑戦して得た学びを大切にしよう。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "失敗と挑戦",
    "text": "転んだ場所にも、次に気をつけるべきことが残っている。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "失敗と挑戦",
    "text": "完璧な成功より、何度も立ち上がる姿勢が人を育てる。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "失敗と挑戦",
    "text": "新しい道には不安があるが、新しい可能性も待っている。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "失敗と挑戦",
    "text": "怖いと感じることは、必ずしも進むべきでない証拠ではない。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "失敗と挑戦",
    "text": "失敗を隠すより、そこから得た教訓を活かそう。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "失敗と挑戦",
    "text": "挑戦するたびに、できることと学ぶべきことが見えてくる。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "失敗と挑戦",
    "text": "失敗を自分の正体にせず、一つの経験として受け止めよう。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "失敗と挑戦",
    "text": "慣れた場所を出るとき、成長の扉が開くことがある。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "失敗と挑戦",
    "text": "何度でも始め直せることは、人生の大きな強みだ。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "希望と未来",
    "text": "未来はまだ書かれていないからこそ、希望を持てる。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "希望と未来",
    "text": "今日の選択は、小さくても明日の景色を変えていく。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "希望と未来",
    "text": "希望は問題がないことではなく、進む道を探す力だ。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "希望と未来",
    "text": "暗い道でも、一歩ずつなら先へ進める。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "希望と未来",
    "text": "未来の自分が感謝する行動を、今日ひとつ選ぼう。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "希望と未来",
    "text": "今の苦労が、いつか誰かを励ます経験になるかもしれない。",
    "language": "ja"
  },
  {
    "id": 107,
    "category": "希望と未来",
    "text": "どんな日にも、次の一歩を選び直す余地がある。",
    "language": "ja"
  },
  {
    "id": 108,
    "category": "希望と未来",
    "text": "夢の形が変わっても、前へ進む気持ちは失われない。",
    "language": "ja"
  },
  {
    "id": 109,
    "category": "希望と未来",
    "text": "明日が不確かだからこそ、今日を大切にできる。",
    "language": "ja"
  },
  {
    "id": 110,
    "category": "希望と未来",
    "text": "希望は遠くの光であると同時に、今の小さな決意でもある。",
    "language": "ja"
  },
  {
    "id": 111,
    "category": "希望と未来",
    "text": "人生の途中で道を変えることも、未来を選ぶ力だ。",
    "language": "ja"
  },
  {
    "id": 112,
    "category": "希望と未来",
    "text": "まだ見ぬ可能性を迎えるために、心を閉じないでいよう。",
    "language": "ja"
  },
  {
    "id": 113,
    "category": "希望と未来",
