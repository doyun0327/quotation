[
  {
    "id": 1,
    "category": "失敗から学ぶ",
    "text": "失敗は、終わりではなく学びの始まりです。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "失敗から学ぶ",
    "text": "うまくいかなかった経験も、次の工夫につながります。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "失敗から学ぶ",
    "text": "間違いに気づけたなら、すでに一歩前進しています。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "失敗から学ぶ",
    "text": "失敗した自分を責め続けず、次にできることを考えましょう。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "失敗から学ぶ",
    "text": "一度の失敗で、自分の可能性を閉じないでください。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "失敗から学ぶ",
    "text": "失敗は、別の方法を試すきっかけになることがあります。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "失敗から学ぶ",
    "text": "つまずいた場所から、次に気をつけることを学べます。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "失敗から学ぶ",
    "text": "結果が望みどおりでなくても、挑戦した意味は消えません。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "失敗から学ぶ",
    "text": "失敗を振り返るときは、自分への優しさも忘れずに。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "失敗から学ぶ",
    "text": "間違いは、あなた自身の価値を減らすものではありません。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "失敗から学ぶ",
    "text": "失敗の理由を一つ見つけるだけでも、前進です。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "失敗から学ぶ",
    "text": "うまくいかなかった方法を知ることも、学びの一部です。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "失敗から学ぶ",
    "text": "失敗を隠すより、そこから得た教訓を大切にしましょう。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "失敗から学ぶ",
    "text": "一度の結果だけで、長い努力の価値を決めないでください。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "失敗から学ぶ",
    "text": "失敗した日は、次の一歩を考えるための時間にもなります。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "失敗から学ぶ",
    "text": "過去の間違いを、未来の自分を縛る鎖にしないでください。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "失敗から学ぶ",
    "text": "何度でもやり直せることは、挑戦する人の強みです。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "失敗から学ぶ",
    "text": "失敗を認める勇気が、改善の始まりになります。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "失敗から学ぶ",
    "text": "つまずきは、進む方向を見直す合図かもしれません。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "失敗から学ぶ",
    "text": "失敗から学ぶ姿勢が、成長を止めない力になります。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "失敗から学ぶ",
    "text": "思いどおりにならない経験にも、役立つ気づきが隠れています。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "失敗から学ぶ",
    "text": "失敗を経験したからこそ見える道もあります。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "失敗から学ぶ",
    "text": "完璧にできなかったことより、挑戦した事実を覚えておきましょう。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "失敗から学ぶ",
    "text": "失敗を自分への判決ではなく、次への情報として受け取りましょう。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "失敗から学ぶ",
    "text": "転んだ回数より、そこから何を学んだかを大切に。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "失敗から学ぶ",
    "text": "間違いを認めることは、弱さではなく誠実さです。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "失敗から学ぶ",
    "text": "失敗した自分にも、もう一度試す機会を与えましょう。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "失敗から学ぶ",
    "text": "一度のつまずきで、あなたの未来まで決まるわけではありません。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "失敗から学ぶ",
    "text": "反省は自分を罰するためではなく、次に進むためにあります。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "失敗から学ぶ",
    "text": "失敗を振り返る時間が、次の成功を支えることがあります。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "失敗から学ぶ",
    "text": "結果が出なかった日にも、経験は確かに残っています。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "失敗から学ぶ",
    "text": "失敗を恐れて何もしないより、学びながら進む道を選びましょう。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "失敗から学ぶ",
    "text": "うまくいかないことが、あなたに合う方法を教えてくれることもあります。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "失敗から学ぶ",
    "text": "失敗を一つ経験するたび、選べる工夫が増えていきます。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "失敗から学ぶ",
    "text": "間違えたあとに行動を変えられたなら、それは成長です。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "失敗から学ぶ",
    "text": "失敗を通して、自分に必要な準備が見えてくることがあります。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "失敗から学ぶ",
    "text": "つまずいた経験が、誰かを理解する優しさにつながることもあります。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "失敗から学ぶ",
    "text": "失敗した日は、自分の価値を疑う日ではありません。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "失敗から学ぶ",
    "text": "やり直すたびに、前よりよい方法を見つけられるかもしれません。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "失敗から学ぶ",
    "text": "失敗は、まだ完成していない自分の一部にすぎません。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "成長",
    "text": "成長は、昨日の自分を少し超えることから始まります。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "成長",
    "text": "小さな変化も、積み重なれば大きな成長になります。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "成長",
    "text": "成長の速さは人それぞれで、比べる必要はありません。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "成長",
    "text": "今できないことは、これから学べることでもあります。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "成長",
    "text": "変化に気づけない日にも、成長は静かに進んでいるかもしれません。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "成長",
    "text": "成長はいつも一直線ではなく、立ち止まる時間も含んでいます。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "成長",
    "text": "新しいことを学ぶたび、自分の世界は少しずつ広がります。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "成長",
    "text": "昨日より少し理解できたなら、それも立派な進歩です。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "成長",
    "text": "自分の弱点を知ることは、成長の出発点になります。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "成長",
    "text": "成長するために、完璧な自分である必要はありません。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "成長",
    "text": "小さな努力を続けることで、少しずつ自信が育ちます。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "成長",
    "text": "成長とは、できることを増やすだけでなく、自分を理解することでもあります。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "成長",
    "text": "変わることを恐れず、新しい学びを受け入れましょう。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "成長",
    "text": "自分の歩幅で進むことも、確かな成長です。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "成長",
    "text": "過去の自分と比べることで、見えなかった進歩に気づけます。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "成長",
    "text": "成長には、失敗を認める素直さが必要です。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "成長",
    "text": "昨日の自分が知らなかったことを、今日学べたなら十分です。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "成長",
    "text": "成長は大きな決断だけでなく、毎日の小さな選択から生まれます。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "成長",
    "text": "自分の変化を急がず、育っていく時間を大切にしましょう。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "成長",
    "text": "学び続ける人には、何度でも新しい始まりがあります。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "成長",
    "text": "成長するほど、知らないことの多さにも気づいていきます。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "成長",
    "text": "うまくできるようになるまでの時間も、成長の一部です。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "成長",
    "text": "自分の考えを見直すことは、後退ではなく成長です。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "成長",
    "text": "昨日の限界が、今日の練習で少し広がることがあります。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "成長",
    "text": "成長は誰かに見せるためではなく、自分の人生を豊かにするためにあります。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "成長",
    "text": "変わった自分を認めることも、次の一歩を支えます。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "成長",
    "text": "小さな成功を喜ぶことが、成長を続ける力になります。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "成長",
    "text": "自分に合う方法を見つけることも、大切な成長です。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "成長",
    "text": "経験を重ねるほど、選択に深みが生まれていきます。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "成長",
    "text": "成長を焦らず、今日できることを丁寧に続けましょう。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "成長",
    "text": "自分の未熟さを認められる人は、学び続けることができます。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "成長",
    "text": "成長とは、過去の自分を否定することではありません。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "成長",
    "text": "少しずつ変わる自分を、きちんと認めてあげましょう。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "成長",
    "text": "うまくいかなかった経験も、未来の自分を育てています。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "成長",
    "text": "成長の証は、失敗しなくなることだけではありません。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "成長",
    "text": "変化の途中にいる自分にも、誇れるところがあります。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "成長",
    "text": "学ぶ姿勢を忘れなければ、何歳からでも成長できます。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "成長",
    "text": "今日の小さな気づきが、明日の行動を変えてくれます。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "成長",
    "text": "成長は、できない自分を責めるより、理解することから始まります。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "成長",
    "text": "自分を少しずつ更新することが、長い道を切り開きます。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "努力と継続",
    "text": "大きな成果は、小さな努力の積み重ねから生まれます。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "努力と継続",
    "text": "続けることが難しい日は、始める量を小さくしましょう。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "努力と継続",
    "text": "速さよりも、自分に合った歩みを続けることが大切です。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "努力と継続",
    "text": "毎日の小さな練習が、いつか大きな力になります。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "努力と継続",
    "text": "努力がすぐに実らなくても、学びは残っていきます。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "努力と継続",
    "text": "休みながら進むことも、継続の一部です。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "努力と継続",
    "text": "今日できる小さなことが、未来の自信をつくります。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "努力と継続",
    "text": "続ける工夫を見つけることも、努力のひとつです。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "努力と継続",
    "text": "一度に全部変えなくても、ひとつずつ変えていけます。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "努力と継続",
    "text": "積み重ねた時間は、やがて自分を支える土台になります。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "努力と継続",
    "text": "目標を小さく分けると、今日の行動が見えてきます。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "努力と継続",
    "text": "努力の形は人それぞれで、比べる必要はありません。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "努力と継続",
    "text": "疲れた日は歩みを緩めても、目標を手放す必要はありません。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "努力と継続",
    "text": "続けられる仕組みをつくることも、意志の強さです。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "努力と継続",
    "text": "昨日より少し工夫できたなら、それも立派な成長です。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "努力と継続",
    "text": "結果が見えない時期にも、根は静かに伸びています。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "努力と継続",
    "text": "一度に遠くへ行くより、戻ってこられる道をつくりましょう。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "努力と継続",
    "text": "努力を続けるには、休息を予定に入れることも大切です。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "努力と継続",
    "text": "小さな達成を認めることで、次の一歩が軽くなります。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "努力と継続",
    "text": "できる範囲で続けることが、長い道を歩く秘訣です。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "努力と継続",
    "text": "習慣は、意志が弱い日にもあなたを助けてくれます。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "努力と継続",
    "text": "毎回完璧にするより、何度も戻ってくることを大切に。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "努力と継続",
    "text": "続けることが難しい日は、目標を小さくしてみましょう。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "努力と継続",
    "text": "自分に合う方法を探すことも、努力の一部です。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "努力と継続",
    "text": "成長は一直線ではなく、休みながら進むこともあります。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "努力と継続",
    "text": "小さな一歩を繰り返すことで、大きな距離を進めます。",
    "language": "ja"
  },
  {
    "id": 107,
    "category": "努力と継続",
    "text": "努力の成果を急がず、今日の行動に目を向けましょう。",
    "language": "ja"
  },
  {
    "id": 108,
    "category": "努力と継続",
    "text": "何度でも再開できることが、継続する力になります。",
    "language": "ja"
  },
  {
    "id": 109,
    "category": "努力と継続",
    "text": "遠くの目標を思いながら、目の前の一つに集中しましょう。",
    "language": "ja"
  },
  {
    "id": 110,
    "category": "努力と継続",
    "text": "成長が遅く感じても、積み重ねが消えるわけではありません。",
    "language": "ja"
  },
  {
    "id": 111,
    "category": "努力と継続",
    "text": "自分を追い詰めずに続ける方法を見つけましょう。",
    "language": "ja"
  },
  {
    "id": 112,
    "category": "努力と継続",
    "text": "今日の努力は、明日の選択肢を増やす準備になります。",
    "language": "ja"
  },
  {
    "id": 113,
    "category": "努力と継続",
