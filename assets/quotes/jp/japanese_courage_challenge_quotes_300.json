[
  {
    "id": 1,
    "category": "勇気",
    "text": "怖さがあっても進む心が、あなたの勇気になります。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "勇気",
    "text": "勇気は、不安が消えたあとではなく、不安とともに動くときに生まれます。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "勇気",
    "text": "完璧でなくても、始める勇気には価値があります。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "勇気",
    "text": "自分の本音に向き合うことから、勇気は育ちます。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "勇気",
    "text": "声を上げることも、静かに耐えることも、勇気になり得ます。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "勇気",
    "text": "弱さを隠すより、弱さを抱えて進むほうが強いこともあります。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "勇気",
    "text": "一歩踏み出す決意が、迷いの向こうに道をつくります。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "勇気",
    "text": "勇気とは、恐れがないことではなく、恐れに支配されないことです。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "勇気",
    "text": "自分を信じる小さな決断が、大きな変化の始まりになります。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "勇気",
    "text": "心が揺れていても、進みたい方向を選んでいいのです。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "勇気",
    "text": "助けを求めることも、立派な勇気の表れです。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "勇気",
    "text": "自分の気持ちを正直に伝えることから、未来は変わります。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "勇気",
    "text": "慣れた場所を離れる一歩には、確かな価値があります。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "勇気",
    "text": "勇気は、特別な人だけが持つものではありません。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "勇気",
    "text": "小さな決断を重ねるたび、心は少しずつ強くなります。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "勇気",
    "text": "怖いと感じるのは、それだけ大切に思っている証かもしれません。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "勇気",
    "text": "迷いながら選んだ一歩も、立派な前進です。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "勇気",
    "text": "自分を守るために断ることも、勇気のひとつです。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "勇気",
    "text": "失敗の可能性があっても、挑む価値のあることがあります。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "勇気",
    "text": "今日の自分にできる勇気を、ひとつだけ選んでみましょう。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "勇気",
    "text": "他人の期待より、自分の心に誠実でいる勇気を大切に。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "勇気",
    "text": "最初の一歩は小さくていい。踏み出したことが大切です。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "勇気",
    "text": "恐れを感じた自分を責めず、次の一歩を考えましょう。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "勇気",
    "text": "勇気は一瞬の決意から生まれ、行動の中で育ちます。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "勇気",
    "text": "誰かと同じ強さでなくても、自分なりの強さで進めます。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "勇気",
    "text": "心の中の小さな声を信じることも、勇気です。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "勇気",
    "text": "自分の限界を決めつけない勇気が、新しい可能性を開きます。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "勇気",
    "text": "昨日できなかったことに向き合う今日の姿は、勇敢です。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "勇気",
    "text": "立ち止まって考えることも、前へ進むための勇気です。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "勇気",
    "text": "自分らしく生きる選択には、いつだって意味があります。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "勇気",
    "text": "怖くても始めた経験は、次の挑戦を支えてくれます。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "勇気",
    "text": "本当の強さは、傷つかないことではなく、回復する力にあります。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "勇気",
    "text": "自分の失敗を認めることは、成長への勇気ある一歩です。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "勇気",
    "text": "新しい道を選ぶとき、誰かの許可を待つ必要はありません。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "勇気",
    "text": "勇気を出した自分を、結果に関係なく認めてあげましょう。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "勇気",
    "text": "小さな声でも、自分の意見を伝えることには意味があります。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "勇気",
    "text": "変わることを恐れず、自分の可能性に扉を開きましょう。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "勇気",
    "text": "一人で抱え込まない選択も、強さのひとつです。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "勇気",
    "text": "自信がなくても行動すれば、自信の種が育ちます。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "勇気",
    "text": "今日の小さな勇気が、明日の自分を助けてくれます。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "挑戦",
    "text": "挑戦するたびに、昨日まで知らなかった自分に出会えます。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "挑戦",
    "text": "新しい道は、歩き始めてから少しずつ見えてきます。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "挑戦",
    "text": "できるかどうかを考える前に、まず一度試してみましょう。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "挑戦",
    "text": "挑戦の価値は、結果だけで決まるものではありません。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "挑戦",
    "text": "慣れた場所を出ると、可能性の景色が広がります。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "挑戦",
    "text": "難しさは、成長の入口になることがあります。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "挑戦",
    "text": "挑戦は、自分の限界を知り、広げていく機会です。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "挑戦",
    "text": "新しいことを学ぶ人に、遅すぎる始まりはありません。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "挑戦",
    "text": "一度の挑戦が、思いがけない道を開くことがあります。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "挑戦",
    "text": "大きな目標も、小さな行動に分ければ近づきやすくなります。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "挑戦",
    "text": "挑戦する前から、自分の可能性に終止符を打たないでください。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "挑戦",
    "text": "初めてのことに戸惑うのは、成長している証でもあります。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "挑戦",
    "text": "新しい経験は、成功しても失敗しても自分の糧になります。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "挑戦",
    "text": "挑戦とは、まだ知らない自分に会いに行く旅です。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "挑戦",
    "text": "結果を急がず、試行錯誤する時間も大切にしましょう。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "挑戦",
    "text": "小さな挑戦を積み重ねれば、大きな目標も近づいてきます。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "挑戦",
    "text": "変化の先には、今まで見えなかった選択肢が待っています。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "挑戦",
    "text": "挑戦の始まりに必要なのは、完璧な計画より最初の一歩です。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "挑戦",
    "text": "失敗を避けるだけでは、出会えない景色があります。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "挑戦",
    "text": "自分にとって少し難しいことが、成長のきっかけになります。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "挑戦",
    "text": "誰かの成功を、自分の挑戦を始める合図にしましょう。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "挑戦",
    "text": "新しい方法を試すことで、止まっていた道が動き出します。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "挑戦",
    "text": "挑戦は、自分の世界を少しずつ広げてくれます。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "挑戦",
    "text": "できない理由を探す前に、できる形を考えてみましょう。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "挑戦",
    "text": "一度でうまくいかなくても、挑戦そのものに意味があります。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "挑戦",
    "text": "慣れない道を歩く経験が、柔軟な心を育てます。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "挑戦",
    "text": "目標が遠く感じる日は、今日できることに集中しましょう。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "挑戦",
    "text": "挑戦する自分を、結果だけで評価しないでください。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "挑戦",
    "text": "小さな実験を重ねることが、大きな発見につながります。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "挑戦",
    "text": "一歩進んでみれば、次に必要なことが見えてくるかもしれません。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "挑戦",
    "text": "挑戦は、今の自分を否定することではなく、可能性を試すことです。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "挑戦",
    "text": "新しい扉は、試してみる人の前で開くことがあります。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "挑戦",
    "text": "自分の得意を活かしながら、苦手にも少しずつ向き合いましょう。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "挑戦",
    "text": "大きな変化は、目立たない挑戦から始まることがあります。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "挑戦",
    "text": "挑戦の途中で計画を変えることも、前進のひとつです。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "挑戦",
    "text": "知らないことを認めると、新しく学ぶ道が開けます。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "挑戦",
    "text": "今までのやり方にこだわらず、別の道を試してみましょう。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "挑戦",
    "text": "挑戦した日々は、未来の自分に選択肢を残してくれます。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "挑戦",
    "text": "小さな成功を喜ぶことが、次の挑戦への力になります。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "挑戦",
    "text": "挑戦するたび、できることの輪郭が少しずつ広がります。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "失敗から学ぶ",
    "text": "失敗は、進む価値がなかった証拠ではありません。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "失敗から学ぶ",
    "text": "うまくいかなかった経験も、次の工夫につながります。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "失敗から学ぶ",
    "text": "転んだ場所から、次に気をつけることを学べます。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "失敗から学ぶ",
    "text": "失敗を恐れるより、そこから何を学ぶかを大切にしましょう。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "失敗から学ぶ",
    "text": "遠回りに見える経験が、後であなたを支えることがあります。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "失敗から学ぶ",
    "text": "間違いに気づけたなら、すでに一歩前進しています。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "失敗から学ぶ",
    "text": "失敗した自分を責め続けず、次の行動を考えてみましょう。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "失敗から学ぶ",
    "text": "結果が望みどおりでなくても、努力の意味は消えません。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "失敗から学ぶ",
    "text": "何度でもやり直せることは、挑戦する人の強みです。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "失敗から学ぶ",
    "text": "今日のつまずきが、明日の知恵になることがあります。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "失敗から学ぶ",
    "text": "失敗は終わりではなく、方法を見直すための情報です。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "失敗から学ぶ",
    "text": "うまくいかなかった理由を知れば、次の一手を選びやすくなります。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "失敗から学ぶ",
    "text": "一度の失敗で、自分の能力すべてを判断しないでください。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "失敗から学ぶ",
    "text": "間違えた経験は、慎重さと工夫を育ててくれます。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "失敗から学ぶ",
    "text": "失敗を認めることは、次の成功に近づくための準備です。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "失敗から学ぶ",
    "text": "思いどおりにならない日にも、学べることは残っています。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "失敗から学ぶ",
    "text": "失敗の数ではなく、そこから立ち上がる工夫を大切に。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "失敗から学ぶ",
    "text": "過去の間違いを、未来の自分を縛る鎖にしないでください。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "失敗から学ぶ",
    "text": "挑戦の途中で失敗したなら、まだ物語の途中です。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "失敗から学ぶ",
    "text": "自分を責める時間を、改善する方法を考える時間に変えましょう。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "失敗から学ぶ",
    "text": "うまくいかなかった方法を知ることも、前進の一部です。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "失敗から学ぶ",
    "text": "失敗を隠すより、学びに変えるほうが未来を強くします。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "失敗から学ぶ",
    "text": "つまずいた経験が、誰かを理解する優しさにつながることもあります。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "失敗から学ぶ",
    "text": "一度の結果だけで、長い努力の価値を決めないでください。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "失敗から学ぶ",
    "text": "やり直すたびに、前よりよい方法を見つけられるかもしれません。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "失敗から学ぶ",
    "text": "失敗から学ぶ姿勢が、成長を止めない力になります。",
    "language": "ja"
  },
  {
    "id": 107,
    "category": "失敗から学ぶ",
    "text": "思い切って挑んだ経験は、結果以上のものを残すことがあります。",
    "language": "ja"
  },
  {
    "id": 108,
    "category": "失敗から学ぶ",
    "text": "失敗を振り返るときは、自分への優しさも忘れずに。",
    "language": "ja"
  },
  {
    "id": 109,
    "category": "失敗から学ぶ",
    "text": "間違いは、あなた自身の価値を減らすものではありません。",
    "language": "ja"
  },
  {
    "id": 110,
    "category": "失敗から学ぶ",
    "text": "失敗した日にも、次の一歩を選ぶ自由があります。",
    "language": "ja"
  },
  {
    "id": 111,
    "category": "失敗から学ぶ",
    "text": "失敗を経験したからこそ見える道もあります。",
    "language": "ja"
  },
  {
    "id": 112,
    "category": "失敗から学ぶ",
    "text": "うまくいかなかった理由を一つ見つけるだけでも前進です。",
    "language": "ja"
  },
  {
    "id": 113,
    "category": "失敗から学ぶ",
    "text": "過ちを認めた瞬間から、変化を始められます。",
    "language": "ja"
  },
  {
    "id": 114,
