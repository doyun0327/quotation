[
  {
    "id": 1,
    "category": "思いやり",
    "text": "相手の立場を想像することから、良い関係は始まる。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "思いやり",
    "text": "小さな気遣いが、心の距離を少しずつ縮める。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "思いやり",
    "text": "優しさは、相手を変えるためではなく理解するために使いたい。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "思いやり",
    "text": "人の話を最後まで聞くことも、立派な愛情表現だ。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "思いやり",
    "text": "思いやりは、言葉より先に態度に表れる。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "思いやり",
    "text": "相手の違いを尊重できる人は、関係を豊かにできる。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "思いやり",
    "text": "正しさを伝える前に、相手の気持ちを受け止めよう。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "思いやり",
    "text": "誰かの弱さを笑わないことが、信頼の始まりになる。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "思いやり",
    "text": "見返りを急がない親切は、心に温かく残る。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "思いやり",
    "text": "優しい一言が、誰かの長い一日を救うこともある。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "信頼と誠実さ",
    "text": "信頼は一度の言葉ではなく、日々の行動で育つ。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "信頼と誠実さ",
    "text": "約束を守ることは、相手の時間と気持ちを大切にすることだ。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "信頼と誠実さ",
    "text": "誠実な関係には、無理に自分を飾る必要がない。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "信頼と誠実さ",
    "text": "本当の信頼は、見ていないところでの態度にも表れる。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "信頼と誠実さ",
    "text": "小さな嘘を重ねると、大きな距離が生まれてしまう。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "信頼と誠実さ",
    "text": "信頼を築くには時間がかかり、失うのは一瞬のこともある。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "信頼と誠実さ",
    "text": "言ったことを行動に移す人は、安心を与える。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "信頼と誠実さ",
    "text": "完璧であることより、正直であることが大切だ。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "信頼と誠実さ",
    "text": "間違いを認められる人は、関係を修復する力を持つ。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "信頼と誠実さ",
    "text": "信頼とは、相手を疑わないことより、誠実に向き合うことだ。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "会話と理解",
    "text": "会話は勝ち負けを決める場ではなく、理解を深める場だ。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "会話と理解",
    "text": "聞く姿勢が変われば、相手の言葉の意味も変わって見える。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "会話と理解",
    "text": "伝えたつもりと、伝わったことは同じではない。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "会話と理解",
    "text": "沈黙を急いで埋めなくても、心が通じる瞬間はある。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "会話と理解",
    "text": "質問することは、相手をもっと知りたいという敬意だ。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "会話と理解",
    "text": "感情が高ぶったときほど、言葉を選ぶ余裕を持ちたい。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "会話と理解",
    "text": "理解されたいなら、まず理解しようとすることから始めよう。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "会話と理解",
    "text": "話し合いでは、相手を言い負かすより解決を探そう。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "会話と理解",
    "text": "言葉の裏にある不安や願いに気づくと、関係は深まる。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "会話と理解",
    "text": "自分の気持ちを穏やかに伝えることも、大切な技術だ。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "境界線と自分らしさ",
    "text": "誰にでも好かれようとすると、自分の心を見失いやすい。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "境界線と自分らしさ",
    "text": "断ることは、相手を拒絶することと同じではない。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "境界線と自分らしさ",
    "text": "健全な関係には、近づく勇気と距離を保つ知恵がいる。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "境界線と自分らしさ",
    "text": "自分を大切にすることは、相手を大切にする土台になる。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "境界線と自分らしさ",
    "text": "無理を続けなければ保てない関係は、見直してもいい。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "境界線と自分らしさ",
    "text": "相手の機嫌をすべて背負う必要はない。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "境界線と自分らしさ",
    "text": "自分の境界線を伝えることは、関係を守る方法でもある。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "境界線と自分らしさ",
    "text": "一人の時間を尊重し合える関係は、長く続きやすい。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "境界線と自分らしさ",
    "text": "自分らしさを隠さなくても安心できる人を大切にしよう。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "境界線と自分らしさ",
    "text": "距離を置くことが、心を守るために必要な日もある。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "友情とつながり",
    "text": "良い友人は、成功を喜び、失敗のときにも耳を傾けてくれる。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "友情とつながり",
    "text": "長い友情は、毎日話すことより、変わらぬ敬意で育つ。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "友情とつながり",
    "text": "一緒に笑える相手は、日常を少し明るくしてくれる。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "友情とつながり",
    "text": "友達の数より、安心して本音を話せる相手が大切だ。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "友情とつながり",
    "text": "久しぶりの再会でも自然でいられるのは、友情の宝物だ。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "友情とつながり",
    "text": "友情は、同じ人間になることではなく、違いを楽しむことだ。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "友情とつながり",
    "text": "相手の幸せを素直に喜べる心は、友情を強くする。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "友情とつながり",
    "text": "支え合う関係では、助ける側も助けられる側も尊い。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "友情とつながり",
    "text": "一緒に過ごした時間は、何気ない思い出に姿を変えて残る。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "友情とつながり",
    "text": "本当の友人は、あなたの可能性を狭めず広げてくれる。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "衝突と許し",
    "text": "意見が違っても、相手への敬意まで手放す必要はない。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "衝突と許し",
    "text": "謝罪は負けを認めることではなく、関係を大切にすることだ。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "衝突と許し",
    "text": "許すことは、傷ついた事実をなかったことにすることではない。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "衝突と許し",
    "text": "怒りの中で決めた言葉は、後悔を連れてくることがある。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "衝突と許し",
    "text": "すべての誤解は、落ち着いて話すことでほどける可能性がある。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "衝突と許し",
    "text": "仲直りには、正しさを競うより気持ちを伝える勇気がいる。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "衝突と許し",
    "text": "相手の過ちを責め続けるより、これからを考える日も必要だ。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "衝突と許し",
    "text": "衝突のあとに学びがあれば、関係は新しく育ち直せる。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "衝突と許し",
    "text": "謝るべきときに謝れることは、強さの一つだ。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "衝突と許し",
    "text": "許しは相手のためだけでなく、自分の心を軽くすることもある。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "別れと出会い",
    "text": "すべての出会いが永遠に続くわけではない。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "別れと出会い",
    "text": "別れは、共に過ごした時間の価値まで消すものではない。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "別れと出会い",
    "text": "離れて初めて気づく優しさもある。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "別れと出会い",
    "text": "縁が終わっても、その人から学んだことは残る。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "別れと出会い",
    "text": "去る人を追い続けるより、残ってくれる人を大切にしよう。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "別れと出会い",
    "text": "新しい出会いは、古い傷に別の意味を与えることがある。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "別れと出会い",
    "text": "人との別れは寂しいが、自分を取り戻す始まりにもなる。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "別れと出会い",
    "text": "すべての人に理解されなくても、あなたの価値は変わらない。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "別れと出会い",
    "text": "離れる選択が、互いにとって優しさになることもある。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "別れと出会い",
    "text": "縁を大切にしながら、変化を受け入れる心も持ちたい。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "感謝と支え合い",
    "text": "感謝を言葉にすると、当たり前に見えた優しさが輝き出す。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "感謝と支え合い",
    "text": "助けてもらったことを覚えている人は、温かいつながりを育てる。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "感謝と支え合い",
    "text": "ありがとうの一言が、関係の空気を柔らかくする。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "感謝と支え合い",
    "text": "支え合いとは、いつも強い人でいることを求めない関係だ。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "感謝と支え合い",
    "text": "誰かの努力に気づいて伝えることは、心への贈り物になる。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "感謝と支え合い",
    "text": "受け取った優しさを、別の誰かへ渡していこう。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "感謝と支え合い",
    "text": "感謝は大げさな言葉より、日々の態度で伝わることがある。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "感謝と支え合い",
    "text": "人は一人で強くなるだけでなく、支え合って前に進める。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "感謝と支え合い",
    "text": "小さな助けを軽く見ない人は、人の温かさを知っている。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "感謝と支え合い",
    "text": "そばにいてくれること自体が、何よりの支えになる日もある。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "思いやり",
    "text": "人間関係は、相手の話を最後まで聞くことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "思いやり",
    "text": "人間関係は、違いを否定せず受け止めることを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "思いやり",
    "text": "人間関係は、小さな変化に気づくことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "思いやり",
    "text": "人間関係は、見返りを求めず手を差し伸べることを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "思いやり",
    "text": "人間関係は、相手の立場を想像することを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "思いやり",
    "text": "人間関係は、弱さを笑わないことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "思いやり",
    "text": "人間関係は、忙しいときにも丁寧に接することを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "思いやり",
    "text": "人間関係は、言葉の奥にある気持ちを考えることを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "思いやり",
    "text": "人間関係は、相手の喜びを一緒に喜ぶことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "思いやり",
    "text": "人間関係は、思いやりを態度で示すことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "思いやり",
    "text": "人間関係は、決めつけずに質問することを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "思いやり",
    "text": "人間関係は、失敗を責める前に事情を聞くことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "思いやり",
    "text": "人間関係は、相手のペースを尊重することを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "思いやり",
    "text": "人間関係は、無理に答えを出させないことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "思いやり",
    "text": "人間関係は、優しい言葉を選ぶことを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "思いやり",
    "text": "人間関係は、相手の努力を認めることを忘れないところから温かくなる。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "思いやり",
    "text": "誰かと向き合うとき、相手の話を最後まで聞くことが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "思いやり",
    "text": "誰かと向き合うとき、違いを否定せず受け止めることが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "思いやり",
    "text": "誰かと向き合うとき、小さな変化に気づくことが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "思いやり",
    "text": "誰かと向き合うとき、見返りを求めず手を差し伸べることが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "思いやり",
    "text": "誰かと向き合うとき、相手の立場を想像することが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "思いやり",
    "text": "誰かと向き合うとき、弱さを笑わないことが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "思いやり",
    "text": "誰かと向き合うとき、忙しいときにも丁寧に接することが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "思いやり",
    "text": "誰かと向き合うとき、言葉の奥にある気持ちを考えることが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "思いやり",
    "text": "誰かと向き合うとき、相手の喜びを一緒に喜ぶことが心の距離を縮めてくれる。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "思いやり",
    "text": "誰かと向き合うとき、思いやりを態度で示すことが心の距離を縮めてくれる。",
    "language": "ja"
  },
