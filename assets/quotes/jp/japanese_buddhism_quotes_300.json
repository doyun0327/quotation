[
  {
    "id": 1,
    "category": "無常",
    "text": "すべては移り変わる。だからこそ、今の一瞬を大切にしよう。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "無常",
    "text": "変化を拒むほど、心は苦しみに縛られていく。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "無常",
    "text": "花が散るからこそ、咲いている姿は美しい。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "無常",
    "text": "永遠に同じものはないと知れば、手放す勇気が生まれる。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "無常",
    "text": "今日の悲しみも、いつか別の形へと変わっていく。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "無常",
    "text": "無常を知ることは、今ある幸せに気づくことでもある。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "無常",
    "text": "移り変わる世界の中で、今できる善い行いを重ねよう。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "無常",
    "text": "変化は失うことだけでなく、新しく始まることでもある。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "無常",
    "text": "季節が巡るように、心の景色も少しずつ変わっていく。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "無常",
    "text": "一瞬一瞬を大切にすることが、無常を生きる知恵になる。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "無常",
    "text": "執着をゆるめると、変化の中にも安らぎを見つけられる。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "無常",
    "text": "過ぎ去った時間を追い続けず、今の一歩に心を向けよう。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "無常",
    "text": "形あるものは変わる。その真実を静かに受け止めよう。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "無常",
    "text": "移ろうものを移ろうままに見つめると、心に余白が生まれる。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "無常",
    "text": "終わりがあるからこそ、出会いはかけがえのないものになる。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "慈悲と思いやり",
    "text": "他者の苦しみに気づく心は、慈悲の始まりである。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "慈悲と思いやり",
    "text": "優しさは、相手を裁く前にその痛みを想像することから生まれる。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "慈悲と思いやり",
    "text": "自分に向ける穏やかさを、他の命にも分け与えよう。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "慈悲と思いやり",
    "text": "慈悲とは、見返りを求めず苦しみを減らそうとする心である。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "慈悲と思いやり",
    "text": "小さな親切も、誰かの心に大きな安らぎを届ける。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "慈悲と思いやり",
    "text": "怒りに怒りで返さず、思いやりで応じる道を探そう。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "慈悲と思いやり",
    "text": "すべての命が安らぎを願っていることを忘れないでいよう。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "慈悲と思いやり",
    "text": "相手の過ちだけでなく、その人の苦しみにも目を向けよう。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "慈悲と思いやり",
    "text": "慈しみの言葉は、争いの火を静める水となる。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "慈悲と思いやり",
    "text": "誰かを助けるとき、自分の心も少しずつ柔らかくなる。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "慈悲と思いやり",
    "text": "思いやりは大きな行為だけでなく、丁寧なまなざしにも宿る。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "慈悲と思いやり",
    "text": "他者の幸せを願う心は、自分の心も明るくする。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "慈悲と思いやり",
    "text": "苦しむ人を責めるより、できる支えを静かに差し出そう。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "慈悲と思いやり",
    "text": "慈悲は弱さではなく、苦しみから目をそらさない強さである。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "慈悲と思いやり",
    "text": "自分と他者を分け隔てず、同じ命として尊重しよう。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "執着を手放す",
    "text": "握りしめる手をゆるめたとき、心は自由を思い出す。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "執着を手放す",
    "text": "欲しいものを増やすより、必要のない執着を減らしてみよう。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "執着を手放す",
    "text": "すべてを思い通りにしようとする心が、苦しみを生むことがある。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "執着を手放す",
    "text": "手放すことは、価値を否定することではなく、縛られないことだ。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "執着を手放す",
    "text": "過去を握りしめず、今ここにあるものを見つめよう。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "執着を手放す",
    "text": "執着に気づくことが、そこから自由になる第一歩である。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "執着を手放す",
    "text": "失うことへの恐れを見つめると、本当に大切なものが見えてくる。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "執着を手放す",
    "text": "他人の評価に心を預けすぎず、自分の行いを整えよう。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "執着を手放す",
    "text": "欲望を静かに観察すれば、それに振り回されにくくなる。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "執着を手放す",
    "text": "手放した余白に、静かな喜びが入り込んでくる。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "執着を手放す",
    "text": "持つことだけが豊かさではない。心が軽いことも豊かさだ。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "執着を手放す",
    "text": "期待を固く握りしめず、現実をそのまま受け止めてみよう。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "執着を手放す",
    "text": "執着を減らすほど、今ある縁への感謝が深まる。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "執着を手放す",
    "text": "思い通りにならないことを認めると、心の争いが静まる。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "執着を手放す",
    "text": "何かを手放すたびに、自分の心の動きを学ぶことができる。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "心の静けさ",
    "text": "心を静めるには、まず今の呼吸に気づけばよい。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "心の静けさ",
    "text": "外の世界が騒がしくても、心に戻る場所を育てよう。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "心の静けさ",
    "text": "静けさは何も起きないことではなく、起きることを穏やかに見つめる力だ。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "心の静けさ",
    "text": "一呼吸ごとに、心を今この場所へ連れ戻そう。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "心の静けさ",
    "text": "考えが浮かんでも、追いかけずに通り過ぎるのを見守ろう。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "心の静けさ",
    "text": "心の波を無理に止めず、波があることに気づいていよう。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "心の静けさ",
    "text": "沈黙の中で、自分の心が何を求めているかを聞いてみよう。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "心の静けさ",
    "text": "焦りに気づいたら、呼吸をゆっくり感じ直そう。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "心の静けさ",
    "text": "心の平穏は、すべてを支配することからは生まれない。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "心の静けさ",
    "text": "今ここに意識を戻すたび、心は少しずつ落ち着いていく。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "心の静けさ",
    "text": "穏やかさは、忙しい日々の中でも育てることができる。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "心の静けさ",
    "text": "感情を否定せず、ただ気づいて見守ることから始めよう。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "心の静けさ",
    "text": "静かな心は、目の前のことをありのままに見る助けになる。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "心の静けさ",
    "text": "一度立ち止まることが、迷いの中の道しるべになる。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "心の静けさ",
    "text": "呼吸は、今ここへ戻るための身近な入り口である。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "正しい行いと智慧",
    "text": "善い行いは、誰かに見られていなくても価値がある。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "正しい行いと智慧",
    "text": "智慧とは、知識を集めるだけでなく、物事を深く見つめることだ。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "正しい行いと智慧",
    "text": "言葉を発する前に、それが真実か、役立つか、優しいかを考えよう。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "正しい行いと智慧",
    "text": "自分の行いを見つめ直すことが、学びの始まりになる。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "正しい行いと智慧",
    "text": "怒りのままに決めず、心が静まってから選択しよう。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "正しい行いと智慧",
    "text": "正しさを語る前に、自分の行動がその教えに沿っているか確かめよう。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "正しい行いと智慧",
    "text": "智慧は、相手を打ち負かすためではなく苦しみを減らすために使いたい。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "正しい行いと智慧",
    "text": "小さな誠実さを重ねることが、心の道を整えていく。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "正しい行いと智慧",
    "text": "他者を傷つけない選択は、自分の心をも穏やかにする。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "正しい行いと智慧",
    "text": "結果だけでなく、そこへ至る行いの質を大切にしよう。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "正しい行いと智慧",
    "text": "善意に智慧を添えれば、助けはより確かなものになる。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "正しい行いと智慧",
    "text": "自分の誤りを認められる心は、学び続ける心である。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "正しい行いと智慧",
    "text": "言葉と行動を整えることから、穏やかな生き方が始まる。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "正しい行いと智慧",
    "text": "見たいものだけを見るのではなく、現実を丁寧に確かめよう。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "正しい行いと智慧",
    "text": "智慧は、急いで答えを出さずに問いを深めることにも宿る。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "感謝と満足",
    "text": "今あるものに気づくと、心の豊かさは静かに広がる。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "感謝と満足",
    "text": "感謝は、足りないものだけを見る心をやわらげてくれる。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "感謝と満足",
    "text": "満足は何も望まないことではなく、今を味わう力でもある。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "感謝と満足",
    "text": "当たり前に見える一日にも、多くの支えが隠れている。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "感謝と満足",
    "text": "少ないものの中にも喜びを見つける心を育てよう。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "感謝と満足",
    "text": "感謝を忘れない人は、小さな幸せを見つけるのが上手になる。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "感謝と満足",
    "text": "得たものを数える時間が、心を落ち着かせてくれる。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "感謝と満足",
    "text": "今日出会った人や出来事に、静かにありがとうを伝えよう。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "感謝と満足",
    "text": "豊かさは所有の量だけでなく、心の満ち足り方にもある。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "感謝と満足",
    "text": "足りないことを嘆く前に、すでにある恵みを見つめてみよう。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "感謝と満足",
    "text": "感謝は過去を温め、今を支え、未来への希望を育てる。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "感謝と満足",
    "text": "小さな食事や一杯の水にも、命を支える恵みがある。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "感謝と満足",
    "text": "今ある縁を大切にすることが、日々の満足につながる。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "感謝と満足",
    "text": "比べる心を休ませると、自分の暮らしの豊かさに気づける。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "感謝と満足",
    "text": "感謝は、何気ない瞬間をかけがえのない時間に変える。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "無常",
    "text": "季節の移ろいを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "無常",
    "text": "変化する心を受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "無常",
    "text": "過ぎ去る時間を受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "無常",
    "text": "花の散る姿を受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "無常",
    "text": "出会いと別れを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "無常",
    "text": "移りゆく喜びを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "無常",
    "text": "思い通りにならない現実を受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "無常",
    "text": "終わりと始まりを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "無常",
    "text": "年を重ねることを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "無常",
    "text": "今の一瞬を受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "無常",
    "text": "変わり続ける世界を受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "無常",
    "text": "失ったものを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "無常",
    "text": "新しい朝を受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "無常",
    "text": "人生の流れを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "無常",
    "text": "形あるものを受け入れると、変化の中にも静けさを見つけられる。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "無常",
    "text": "季節の移ろいは、今この瞬間を大切にする理由を教えてくれる。",
    "language": "ja"
  },
  {
    "id": 107,
    "category": "無常",
    "text": "変化する心は、今この瞬間を大切にする理由を教えてくれる。",
    "language": "ja"
  },
  {
    "id": 108,
    "category": "無常",
    "text": "過ぎ去る時間は、今この瞬間を大切にする理由を教えてくれる。",
    "language": "ja"
  },
  {
    "id": 109,
    "category": "無常",
    "text": "花の散る姿は、今この瞬間を大切にする理由を教えてくれる。",
    "language": "ja"
  },
  {
