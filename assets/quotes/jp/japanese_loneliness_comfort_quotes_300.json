  },
  {
    "id": 215,
    "category": "慰めと癒やし",
    "text": "涙が出るときは、無理にこらえなくても大丈夫です。",
    "language": "ja"
  },
  {
    "id": 216,
    "category": "慰めと癒やし",
    "text": "今すぐ前向きになれなくても、ゆっくり休むことはできます。",
    "language": "ja"
  },
  {
    "id": 217,
    "category": "慰めと癒やし",
    "text": "苦しいときは、すべてを一人で解決しようとしなくていいのです。",
    "language": "ja"
  },
  {
    "id": 218,
    "category": "つながりと友情",
    "text": "短いメッセージが、誰かとの距離を近づけることがあります。",
    "language": "ja"
  },
  {
    "id": 219,
    "category": "つながりと友情",
    "text": "完璧な言葉がなくても、気にかける気持ちは伝わります。",
    "language": "ja"
  },
  {
    "id": 220,
    "category": "つながりと友情",
    "text": "人とのつながりは、小さな挨拶から始まることがあります。",
    "language": "ja"
  },
  {
    "id": 221,
    "category": "つながりと友情",
    "text": "誰かの話を静かに聞くことも、大切な支えになります。",
    "language": "ja"
  },
  {
    "id": 222,
    "category": "つながりと友情",
    "text": "あなたを理解しようとしてくれる人との関係を大切にしましょう。",
    "language": "ja"
  },
  {
    "id": 223,
    "category": "つながりと友情",
    "text": "毎日話さなくても、続いていく関係はあります。",
    "language": "ja"
  },
  {
    "id": 224,
    "category": "つながりと友情",
    "text": "誰かに頼ることは、弱さではなく信頼の表れです。",
    "language": "ja"
  },
  {
    "id": 225,
    "category": "つながりと友情",
    "text": "自分を偽らずにいられる相手との時間を大切にしましょう。",
    "language": "ja"
  },
  {
    "id": 226,
    "category": "つながりと友情",
    "text": "小さな親切が、誰かの孤独をやわらげることがあります。",
    "language": "ja"
  },
  {
    "id": 227,
    "category": "自分への優しさ",
    "text": "自分に向ける言葉を、少しだけ柔らかくしてみましょう。",
    "language": "ja"
  },
  {
    "id": 228,
    "category": "自分への優しさ",
    "text": "自分を責める代わりに、今必要な支えを考えてみましょう。",
    "language": "ja"
  },
  {
    "id": 229,
    "category": "自分への優しさ",
    "text": "自分を愛することは、完璧になることではなく見捨てないことです。",
    "language": "ja"
  },
  {
    "id": 230,
    "category": "希望と明日",
    "text": "あなたを大切にしてくれる人との出会いは、未来に残されています。",
    "language": "ja"
  },
  {
    "id": 231,
    "category": "希望と明日",
    "text": "今日の寂しさを、未来のすべての答えにしないでください。",
    "language": "ja"
  },
  {
    "id": 232,
    "category": "孤独",
    "text": "誰にも会いたくない日も、誰かにそばにいてほしい日もあっていいのです。",
    "language": "ja"
  },
  {
    "id": 233,
    "category": "孤独",
    "text": "ひとりの時間を、孤独だけでなく休息の時間にもしてみましょう。",
    "language": "ja"
  },
  {
    "id": 234,
    "category": "孤独",
    "text": "寂しいときは、短い挨拶からつながりを作ってみてもいいのです。",
    "language": "ja"
  },
  {
    "id": 235,
    "category": "孤独",
    "text": "自分の寂しさを否定せず、必要なつながりを探してみましょう。",
