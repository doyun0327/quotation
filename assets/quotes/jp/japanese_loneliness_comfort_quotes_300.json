[
  {
    "id": 1,
    "category": "孤独",
    "text": "ひとりでいる時間が、いつも寂しさを意味するわけではありません。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "孤独",
    "text": "誰にもわかってもらえないと感じる夜にも、あなたの気持ちは大切です。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "孤独",
    "text": "孤独を感じる自分を、弱い人だと決めつけないでください。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "孤独",
    "text": "人に囲まれていても寂しい日があるのは、自然なことです。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "孤独",
    "text": "心がひとりぼっちに感じるときは、自分の声にも耳を傾けてみましょう。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "孤独",
    "text": "孤独な時間にも、自分を知る小さなきっかけが隠れています。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "孤独",
    "text": "寂しさを感じることは、誰かとのつながりを大切にしている証かもしれません。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "孤独",
    "text": "ひとりの夜を、無理に明るく過ごそうとしなくても大丈夫です。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "孤独",
    "text": "孤独な気持ちを抱えたままでも、あなたの価値は変わりません。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "孤独",
    "text": "誰かがそばにいない時間にも、自分をいたわることはできます。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "孤独",
    "text": "寂しいと感じたら、その気持ちを否定せず認めてあげましょう。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "孤独",
    "text": "孤独はあなたの人生のすべてではなく、今感じている一つの気持ちです。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "孤独",
    "text": "ひとりで過ごす日にも、小さな喜びを見つけることはできます。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "孤独",
    "text": "誰かと比べて寂しさを深めず、自分の心に必要なものを考えましょう。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "孤独",
    "text": "孤独を感じる夜にも、朝は少しずつ近づいています。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "孤独",
    "text": "ひとりで頑張り続けなくてもいいのです。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "孤独",
    "text": "寂しさを隠すために、無理に笑わなくても大丈夫です。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "孤独",
    "text": "誰かに会いたいと思う気持ちを、恥ずかしがらないでください。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "孤独",
    "text": "孤独なときこそ、自分にやさしい言葉をかけてあげましょう。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "孤独",
    "text": "今はひとりでも、これから出会う人まで決まっているわけではありません。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "孤独",
    "text": "寂しい心にも、休める場所と時間が必要です。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "孤独",
    "text": "誰にも連絡できないと感じる日も、自分を責めないでください。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "孤独",
    "text": "孤独を感じる自分にも、愛される価値があります。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "孤独",
    "text": "ひとりの時間を、心を回復させる時間に変えられることもあります。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "孤独",
    "text": "寂しさが強い日は、身近な景色をゆっくり眺めてみましょう。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "孤独",
    "text": "孤独を感じたからといって、あなたが取り残されたわけではありません。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "孤独",
    "text": "誰かの存在が恋しいときは、その気持ちを大切にしていいのです。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "孤独",
    "text": "ひとりでいることと、ひとりぼっちであることは同じではありません。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "孤独",
    "text": "寂しい気持ちは、ずっと同じ強さで続くとは限りません。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "孤独",
    "text": "孤独な夜にも、自分を守る小さな習慣を持ちましょう。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "孤独",
    "text": "誰かとつながりたいと思うことは、人として自然な願いです。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "孤独",
    "text": "ひとりでいる自分を、ほかの人の暮らしと比べなくてもいいのです。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "孤独",
    "text": "寂しさを感じる日は、自分の心を急かさずに過ごしましょう。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "孤独",
    "text": "孤独な気持ちを言葉にすることから、つながりが始まることもあります。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "孤独",
    "text": "今は理解者が見つからなくても、あなたの気持ちに価値はあります。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "孤独",
    "text": "ひとりの時間にも、自分の好きなものを大切にしてみましょう。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "孤独",
    "text": "寂しさを感じる自分に、温かい飲み物を差し出すように接しましょう。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "孤独",
    "text": "誰かがいないことだけで、自分の人生を空っぽだと決めないでください。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "孤独",
    "text": "孤独な時間にも、あなたらしい日々を育てていくことはできます。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "孤独",
    "text": "寂しいときは、誰かに助けを求めてもいいのです。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "慰めと癒やし",
    "text": "疲れた心には、正しい答えよりも温かい言葉が必要なことがあります。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "慰めと癒やし",
    "text": "今日は頑張り続けず、少し休んでもいいのです。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "慰めと癒やし",
    "text": "涙が出る日は、心が何かを伝えようとしているのかもしれません。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "慰めと癒やし",
    "text": "無理に元気にならなくても、あなたは大切な存在です。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "慰めと癒やし",
    "text": "傷ついた心が回復するには、自分のペースが必要です。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "慰めと癒やし",
    "text": "今すぐ笑えなくても、穏やかな日がまた訪れるかもしれません。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "慰めと癒やし",
    "text": "つらい気持ちを抱えている自分に、やさしく接してください。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "慰めと癒やし",
    "text": "何もできない日にも、あなた自身の価値は失われません。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "慰めと癒やし",
    "text": "心が疲れたときは、できることを少し減らしてみましょう。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "慰めと癒やし",
    "text": "今日を乗り越えただけでも、十分に頑張ったと言える日があります。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "慰めと癒やし",
    "text": "悲しみを急いで片づけず、少しずつ受け止めていきましょう。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "慰めと癒やし",
    "text": "自分の痛みを、ほかの人の痛みと比べなくてもいいのです。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "慰めと癒やし",
    "text": "休むことは、あきらめることではありません。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "慰めと癒やし",
    "text": "心が弱っているときは、信頼できる人の手を借りても大丈夫です。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "慰めと癒やし",
    "text": "自分にかける言葉を、少しだけ柔らかくしてみましょう。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "慰めと癒やし",
    "text": "うまくできなかった日にも、自分をいたわる理由はあります。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "慰めと癒やし",
    "text": "つらい気持ちがあることを、無理に隠さなくてもいいのです。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "慰めと癒やし",
    "text": "一度にすべてを乗り越えようとせず、今日の分だけ進みましょう。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "慰めと癒やし",
    "text": "自分を責める代わりに、今必要なものを尋ねてみてください。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "慰めと癒やし",
    "text": "心の傷は、急がせるよりも大切に扱うことで癒えていきます。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "慰めと癒やし",
    "text": "泣いたあとに少し呼吸が楽になるなら、その涙にも意味があります。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "慰めと癒やし",
    "text": "今日は自分に、何かひとつ優しいことをしてあげましょう。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "慰めと癒やし",
    "text": "元気が戻るまで、無理に誰かの期待に応えなくても大丈夫です。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "慰めと癒やし",
    "text": "疲れた心を休ませる時間は、決して無駄ではありません。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "慰めと癒やし",
    "text": "苦しいときは、すべてを一人で解決しなくてもいいのです。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "慰めと癒やし",
    "text": "自分の弱さを認めることも、自分を大切にする一歩です。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "慰めと癒やし",
    "text": "悲しい気持ちがある日にも、小さな安心を探してみましょう。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "慰めと癒やし",
    "text": "今日の自分にできる範囲を認めることも、立派な優しさです。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "慰めと癒やし",
    "text": "心が落ち着くまで、決断を少し先に延ばしてもかまいません。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "慰めと癒やし",
    "text": "自分に優しくすることから、回復が始まることがあります。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "慰めと癒やし",
    "text": "誰かに頼ることは、あなたの強さを奪うものではありません。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "慰めと癒やし",
    "text": "うまく言葉にできない気持ちも、確かに存在しています。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "慰めと癒やし",
    "text": "つらい時期を過ごす自分に、休む許可を出してあげましょう。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "慰めと癒やし",
    "text": "今日はただ静かに過ごすことが、必要な日かもしれません。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "慰めと癒やし",
    "text": "自分の心に、すぐに答えを出すよう求めないでください。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "慰めと癒やし",
    "text": "一歩も進めないように感じる日にも、あなたは生きています。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "慰めと癒やし",
    "text": "自分の苦しさを小さく扱わず、必要な支えを探しましょう。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "慰めと癒やし",
    "text": "涙を流すことも、心が緊張をほどく方法のひとつです。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "慰めと癒やし",
    "text": "心が疲れた日は、できたことを一つだけ数えてみましょう。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "慰めと癒やし",
    "text": "あなたは、いつも強く振る舞わなくても大切な人です。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "つながりと友情",
    "text": "短い一言でも、誰かを思う気持ちは届くことがあります。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "つながりと友情",
    "text": "完璧な言葉がなくても、そばにいようとする気持ちは伝わります。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "つながりと友情",
    "text": "本当のつながりは、いつも長い会話から生まれるとは限りません。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "つながりと友情",
    "text": "誰かに「元気？」と聞くことが、温かい橋になることがあります。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "つながりと友情",
    "text": "弱いところを見せられる相手がいることは、心の支えになります。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "つながりと友情",
    "text": "つながりは、少しずつ育てていけるものです。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "つながりと友情",
    "text": "連絡をする勇気が、思いがけない会話を始めるかもしれません。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "つながりと友情",
    "text": "あなたを大切にする人は、完璧なあなたでなくても向き合ってくれます。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "つながりと友情",
    "text": "誰かの話を静かに聞くことも、深い優しさです。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "つながりと友情",
    "text": "助けを求める言葉は、つながりへの扉になることがあります。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "つながりと友情",
    "text": "人との距離は、時間と対話によって少しずつ変わっていきます。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "つながりと友情",
    "text": "小さな親切が、誰かの孤独を和らげることがあります。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "つながりと友情",
    "text": "大切な関係は、毎日話さなくても続くことがあります。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "つながりと友情",
    "text": "気持ちを伝えることは、相手に近づくための一歩です。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "つながりと友情",
    "text": "あなたの存在を喜んでくれる人との出会いは、これからもあり得ます。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "つながりと友情",
    "text": "誰かを思い出したなら、短いメッセージを送ってみてもいいのです。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "つながりと友情",
    "text": "優しさは、大きな行動より小さな気づかいに表れることがあります。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "つながりと友情",
    "text": "人に頼ることも、信頼を育てる方法のひとつです。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "つながりと友情",
    "text": "相手の話を最後まで聞くことが、安心を生むことがあります。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "つながりと友情",
    "text": "あなたの気持ちを大切に扱ってくれる人との関係を育てましょう。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "つながりと友情",
    "text": "すべてを理解し合えなくても、互いを尊重することはできます。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "つながりと友情",
    "text": "誰かとつながるために、無理に自分を変える必要はありません。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "つながりと友情",
    "text": "小さな挨拶が、新しい関係の始まりになることがあります。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "つながりと友情",
    "text": "人とのつながりは、遠く離れていても育てていけます。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "つながりと友情",
    "text": "大切な人に頼ることは、迷惑をかけることと同じではありません。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "つながりと友情",
    "text": "優しい言葉は、相手の心に長く残ることがあります。",
    "language": "ja"
  },
  {
    "id": 107,
    "category": "つながりと友情",
    "text": "心を開くには時間がかかっても、遅すぎることはありません。",
    "language": "ja"
  },
  {
    "id": 108,
    "category": "つながりと友情",
    "text": "あなたの存在が、誰かの一日を明るくしているかもしれません。",
    "language": "ja"
  },
  {
    "id": 109,
    "category": "つながりと友情",
    "text": "思いやりは、相手を変えることより理解しようとする姿勢に表れます。",
    "language": "ja"
  },
  {
    "id": 110,
    "category": "つながりと友情",
    "text": "つながりを求める気持ちを、恥ずかしがらなくても大丈夫です。",
    "language": "ja"
  },
  {
    "id": 111,
    "category": "つながりと友情",
    "text": "安心できる関係では、沈黙も必ずしも気まずいものではありません。",
    "language": "ja"
  },
  {
    "id": 112,
    "category": "つながりと友情",
    "text": "誰かのそばにいることは、問題を解決することだけではありません。",
    "language": "ja"
  },
  {
    "id": 113,
    "category": "つながりと友情",
    "text": "言葉が見つからないときは、ただ聞くことから始めましょう。",
    "language": "ja"
  },
  {
    "id": 114,
    "category": "つながりと友情",
    "text": "友人に向ける優しさを、自分にも向けてあげましょう。",
    "language": "ja"
  },
  {
    "id": 115,
    "category": "つながりと友情",
    "text": "関係を育てるには、相手だけでなく自分の気持ちも大切です。",
    "language": "ja"
  },
  {
    "id": 116,
    "category": "つながりと友情",
    "text": "一度のすれ違いだけで、すべてのつながりをあきらめないでください。",
    "language": "ja"
  },
  {
    "id": 117,
    "category": "つながりと友情",
    "text": "小さな気づかいが、安心して話せる場所をつくります。",
    "language": "ja"
  },
  {
    "id": 118,
    "category": "つながりと友情",
    "text": "あなたを理解しようとする人との出会いは、まだこれからもあります。",
    "language": "ja"
  },
  {
    "id": 119,
    "category": "つながりと友情",
    "text": "誰かの優しさを受け取ることも、心を開く大切な一歩です。",
    "language": "ja"
  },
  {
    "id": 120,
    "category": "つながりと友情",
    "text": "つながりは、互いに完璧でないことを認めるところから育ちます。",
    "language": "ja"
  },
  {
    "id": 121,
    "category": "自分への優しさ",
    "text": "自分の一番の味方でいられるように、心に優しい言葉をかけましょう。",
    "language": "ja"
  },
  {
    "id": 122,
    "category": "自分への優しさ",
    "text": "誰かに愛されるために、自分を削り続ける必要はありません。",
    "language": "ja"
  },
  {
    "id": 123,
    "category": "自分への優しさ",
    "text": "ひとりの時間にも、自分を大切に扱うことができます。",
    "language": "ja"
  },
  {
    "id": 124,
    "category": "自分への優しさ",
    "text": "自分の寂しさを認めることは、弱さではありません。",
    "language": "ja"
  },
  {
    "id": 125,
    "category": "自分への優しさ",
    "text": "自分の心が求める休息を、後回しにしないでください。",
    "language": "ja"
  },
  {
    "id": 126,
    "category": "自分への優しさ",
    "text": "自分を責める声が大きい日は、できたことにも目を向けましょう。",
    "language": "ja"
  },
  {
    "id": 127,
    "category": "自分への優しさ",
    "text": "自分に優しくすることは、わがままではありません。",
    "language": "ja"
  },
  {
    "id": 128,
    "category": "自分への優しさ",
    "text": "誰かと比べず、自分に合った幸せの形を探してみましょう。",
    "language": "ja"
  },
  {
    "id": 129,
    "category": "自分への優しさ",
    "text": "自分の気持ちを尊重することから、心の安心が育ちます。",
    "language": "ja"
  },
  {
    "id": 130,
    "category": "自分への優しさ",
    "text": "孤独な日にも、自分との関係を少しずつ育てられます。",
    "language": "ja"
  },
  {
    "id": 131,
    "category": "自分への優しさ",
    "text": "自分の歩幅を守ることは、長く生きていくための知恵です。",
    "language": "ja"
  },
  {
    "id": 132,
    "category": "自分への優しさ",
    "text": "自分の感情を否定せず、そこにある理由を探してみましょう。",
    "language": "ja"
  },
  {
    "id": 133,
    "category": "自分への優しさ",
    "text": "誰かの期待に応えられない日にも、自分の価値は変わりません。",
    "language": "ja"
  },
  {
    "id": 134,
    "category": "自分への優しさ",
    "text": "自分を大切にする選択を、罪悪感で手放さないでください。",
    "language": "ja"
  },
  {
    "id": 135,
    "category": "自分への優しさ",
    "text": "心が疲れたら、予定を減らすことも自分への優しさです。",
    "language": "ja"
  },
  {
    "id": 136,
    "category": "自分への優しさ",
    "text": "自分の弱さを受け入れることが、安心の始まりになることがあります。",
    "language": "ja"
  },
  {
    "id": 137,
    "category": "自分への優しさ",
    "text": "寂しい自分を否定せず、必要なつながりを探してみましょう。",
    "language": "ja"
  },
  {
    "id": 138,
    "category": "自分への優しさ",
    "text": "あなたの気持ちは、説明が完璧でなくても大切です。",
    "language": "ja"
  },
  {
    "id": 139,
    "category": "自分への優しさ",
    "text": "自分に休む許可を出すことも、自分を信じる行為です。",
    "language": "ja"
  },
  {
    "id": 140,
    "category": "自分への優しさ",
    "text": "自分をいたわる小さな習慣が、心の支えになります。",
    "language": "ja"
  },
  {
    "id": 141,
    "category": "自分への優しさ",
    "text": "今の自分にできる範囲を認め、無理をしすぎないでください。",
    "language": "ja"
  },
  {
    "id": 142,
    "category": "自分への優しさ",
    "text": "自分のために時間を使うことに、言い訳はいりません。",
    "language": "ja"
  },
  {
    "id": 143,
    "category": "自分への優しさ",
    "text": "心の声を聞くことは、周りの人を大切にすることとも両立します。",
    "language": "ja"
  },
  {
    "id": 144,
    "category": "自分への優しさ",
    "text": "自分に優しくできなかった日も、またやり直せます。",
