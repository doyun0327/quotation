  },
  {
    "id": 145,
    "category": "自分への優しさ",
    "text": "自分の気持ちを言葉にすることから、必要な助けが見えてくることがあります。",
    "language": "ja"
  },
  {
    "id": 146,
    "category": "自分への優しさ",
    "text": "自分の人生を、他人の幸せそうな姿だけで判断しないでください。",
    "language": "ja"
  },
  {
    "id": 147,
    "category": "自分への優しさ",
    "text": "誰かに選ばれることだけが、あなたの価値を決めるわけではありません。",
    "language": "ja"
  },
  {
    "id": 148,
    "category": "自分への優しさ",
    "text": "自分の寂しさに気づいたら、責めずに小さなケアを選びましょう。",
    "language": "ja"
  },
  {
    "id": 149,
    "category": "自分への優しさ",
    "text": "あなたは、役に立つときだけ価値がある存在ではありません。",
    "language": "ja"
  },
  {
    "id": 150,
    "category": "自分への優しさ",
    "text": "心の余裕を守るために、断ることも選んでいいのです。",
    "language": "ja"
  },
  {
    "id": 151,
    "category": "自分への優しさ",
    "text": "自分に向ける言葉を変えるだけで、日々の感じ方が変わることがあります。",
    "language": "ja"
  },
  {
    "id": 152,
    "category": "自分への優しさ",
    "text": "今の自分を受け入れることは、成長をあきらめることではありません。",
    "language": "ja"
  },
  {
    "id": 153,
    "category": "自分への優しさ",
    "text": "自分を大切にすることは、誰かを大切にする力にもつながります。",
    "language": "ja"
  },
  {
    "id": 154,
    "category": "自分への優しさ",
    "text": "自分の心に必要なものを、ゆっくり確かめてみましょう。",
    "language": "ja"
  },
  {
    "id": 155,
    "category": "自分への優しさ",
    "text": "できなかったことだけでなく、今日を過ごした自分を認めましょう。",
    "language": "ja"
  },
  {
    "id": 156,
    "category": "自分への優しさ",
    "text": "自分の気持ちを大切にすることから、穏やかな関係が始まります。",
    "language": "ja"
  },
  {
    "id": 157,
    "category": "自分への優しさ",
    "text": "ひとりでいる時間を、孤独だけでなく休息の時間にもしてみましょう。",
    "language": "ja"
  },
  {
    "id": 158,
    "category": "自分への優しさ",
    "text": "自分を責める代わりに、今必要な支えを考えてみてください。",
    "language": "ja"
  },
  {
    "id": 159,
    "category": "自分への優しさ",
    "text": "あなたには、誰かとつながりながら自分らしくいる権利があります。",
