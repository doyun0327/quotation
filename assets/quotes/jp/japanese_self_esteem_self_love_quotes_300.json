[
  {
    "id": 1,
    "category": "自尊心と自己愛",
    "text": "自分を大切にすることは、わがままではなく生きる土台だ。",
    "language": "ja"
  },
  {
    "id": 2,
    "category": "自尊心と自己愛",
    "text": "誰かに認められる前に、自分の存在を認めてあげよう。",
    "language": "ja"
  },
  {
    "id": 3,
    "category": "自尊心と自己愛",
    "text": "あなたの価値は、他人の評価だけでは決まらない。",
    "language": "ja"
  },
  {
    "id": 4,
    "category": "自尊心と自己愛",
    "text": "完璧でなくても、あなたは大切にされる価値がある。",
    "language": "ja"
  },
  {
    "id": 5,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、弱さも含めて自分を受け入れること。",
    "language": "ja"
  },
  {
    "id": 6,
    "category": "自尊心と自己愛",
    "text": "他人と比べるより、昨日の自分の歩みを見つめよう。",
    "language": "ja"
  },
  {
    "id": 7,
    "category": "自尊心と自己愛",
    "text": "自分の心に優しい言葉をかけることから、自己愛は始まる。",
    "language": "ja"
  },
  {
    "id": 8,
    "category": "自尊心と自己愛",
    "text": "失敗した自分にも、やり直す機会を与えてあげよう。",
    "language": "ja"
  },
  {
    "id": 9,
    "category": "自尊心と自己愛",
    "text": "自分を尊重することは、自分の気持ちに耳を傾けること。",
    "language": "ja"
  },
  {
    "id": 10,
    "category": "自尊心と自己愛",
    "text": "あなたは、何かを成し遂げた日だけ価値があるのではない。",
    "language": "ja"
  },
  {
    "id": 11,
    "category": "自尊心と自己愛",
    "text": "自分らしさを守る勇気は、静かな自信を育てる。",
    "language": "ja"
  },
  {
    "id": 12,
    "category": "自尊心と自己愛",
    "text": "誰かの期待に応えるために、自分を見失わなくていい。",
    "language": "ja"
  },
  {
    "id": 13,
    "category": "自尊心と自己愛",
    "text": "自分の限界を認めることも、自分を大切にする知恵だ。",
    "language": "ja"
  },
  {
    "id": 14,
    "category": "自尊心と自己愛",
    "text": "自分を責める癖に気づいたら、いたわる言葉に変えてみよう。",
    "language": "ja"
  },
  {
    "id": 15,
    "category": "自尊心と自己愛",
    "text": "自分の人生を他人の物差しだけで測らないで。",
    "language": "ja"
  },
  {
    "id": 16,
    "category": "自尊心と自己愛",
    "text": "小さな成長を認めることが、自信の種になる。",
    "language": "ja"
  },
  {
    "id": 17,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、いつも自分を好きでいることではなく、見捨てないこと。",
    "language": "ja"
  },
  {
    "id": 18,
    "category": "自尊心と自己愛",
    "text": "あなたの歩みが遅くても、その歩みには意味がある。",
    "language": "ja"
  },
  {
    "id": 19,
    "category": "自尊心と自己愛",
    "text": "自分の気持ちを大切にすることは、他人を大切にすることと両立する。",
    "language": "ja"
  },
  {
    "id": 20,
    "category": "自尊心と自己愛",
    "text": "人に優しくするように、自分にも優しくしてみよう。",
    "language": "ja"
  },
  {
    "id": 21,
    "category": "自尊心と自己愛",
    "text": "自分の欠点だけで、自分の全体を決めつけないで。",
    "language": "ja"
  },
  {
    "id": 22,
    "category": "自尊心と自己愛",
    "text": "自信は、完璧さではなく自分を信じ直す経験から育つ。",
    "language": "ja"
  },
  {
    "id": 23,
    "category": "自尊心と自己愛",
    "text": "自分の価値を証明し続けなくても、あなたはここにいていい。",
    "language": "ja"
  },
  {
    "id": 24,
    "category": "自尊心と自己愛",
    "text": "心が疲れたとき、自分を休ませることも愛情だ。",
    "language": "ja"
  },
  {
    "id": 25,
    "category": "自尊心と自己愛",
    "text": "自分を認める一歩は、今の自分を否定しないこと。",
    "language": "ja"
  },
  {
    "id": 26,
    "category": "自尊心と自己愛",
    "text": "あなたには、自分の気持ちを尊重する権利がある。",
    "language": "ja"
  },
  {
    "id": 27,
    "category": "自尊心と自己愛",
    "text": "他人の輝きは、あなたの光を消すものではない。",
    "language": "ja"
  },
  {
    "id": 28,
    "category": "自尊心と自己愛",
    "text": "自分らしく生きることに、誰かの許可はいらない。",
    "language": "ja"
  },
  {
    "id": 29,
    "category": "自尊心と自己愛",
    "text": "自分を好きになる道は、少しずつ自分を理解する道でもある。",
    "language": "ja"
  },
  {
    "id": 30,
    "category": "自尊心と自己愛",
    "text": "間違いをした自分にも、学び直す価値がある。",
    "language": "ja"
  },
  {
    "id": 31,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かと同じでなくても十分に価値がある。",
    "language": "ja"
  },
  {
    "id": 32,
    "category": "自尊心と自己愛",
    "text": "自分の心を守るために境界線を引くことは、大切な強さだ。",
    "language": "ja"
  },
  {
    "id": 33,
    "category": "自尊心と自己愛",
    "text": "できなかったことだけでなく、乗り越えたことも数えよう。",
    "language": "ja"
  },
  {
    "id": 34,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、自分の幸せを後回しにし続けないこと。",
    "language": "ja"
  },
  {
    "id": 35,
    "category": "自尊心と自己愛",
    "text": "人に好かれるために、自分の本音を消さなくていい。",
    "language": "ja"
  },
  {
    "id": 36,
    "category": "自尊心と自己愛",
    "text": "自分の弱さを知ることは、自分を嫌う理由ではない。",
    "language": "ja"
  },
  {
    "id": 37,
    "category": "自尊心と自己愛",
    "text": "あなたの価値は、誰かに選ばれるかどうかで決まらない。",
    "language": "ja"
  },
  {
    "id": 38,
    "category": "自尊心と自己愛",
    "text": "自分を信じる力は、小さな約束を自分と守ることで育つ。",
    "language": "ja"
  },
  {
    "id": 39,
    "category": "自尊心と自己愛",
    "text": "自分のペースを尊重することが、長く歩く力になる。",
    "language": "ja"
  },
  {
    "id": 40,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする選択を、罪悪感なしにしていい。",
    "language": "ja"
  },
  {
    "id": 41,
    "category": "自尊心と自己愛",
    "text": "誰かの意見を聞いても、自分の価値まで明け渡さないで。",
    "language": "ja"
  },
  {
    "id": 42,
    "category": "自尊心と自己愛",
    "text": "自分を好きになれない日にも、自分をいたわることはできる。",
    "language": "ja"
  },
  {
    "id": 43,
    "category": "自尊心と自己愛",
    "text": "過去の失敗は、あなたの未来を決める判決ではない。",
    "language": "ja"
  },
  {
    "id": 44,
    "category": "自尊心と自己愛",
    "text": "自分のよさに気づくことは、傲慢ではなく自己理解だ。",
    "language": "ja"
  },
  {
    "id": 45,
    "category": "自尊心と自己愛",
    "text": "あなたは、いつも強くなくても大切な存在だ。",
    "language": "ja"
  },
  {
    "id": 46,
    "category": "自尊心と自己愛",
    "text": "自分を責める代わりに、何が必要なのか尋ねてみよう。",
    "language": "ja"
  },
  {
    "id": 47,
    "category": "自尊心と自己愛",
    "text": "自分の幸せを選ぶことは、誰かを傷つけることと同じではない。",
    "language": "ja"
  },
  {
    "id": 48,
    "category": "自尊心と自己愛",
    "text": "あなたの個性は、誰かと違うからこそ生まれる魅力を持っている。",
    "language": "ja"
  },
  {
    "id": 49,
    "category": "自尊心と自己愛",
    "text": "自分に向ける言葉を変えると、自分との関係も変わっていく。",
    "language": "ja"
  },
  {
    "id": 50,
    "category": "自尊心と自己愛",
    "text": "他人のペースではなく、自分に合った歩き方を探そう。",
    "language": "ja"
  },
  {
    "id": 51,
    "category": "自尊心と自己愛",
    "text": "自分の感情を否定せず、まず存在を認めてあげよう。",
    "language": "ja"
  },
  {
    "id": 52,
    "category": "自尊心と自己愛",
    "text": "完璧な自分を待たずに、今の自分を大切にしよう。",
    "language": "ja"
  },
  {
    "id": 53,
    "category": "自尊心と自己愛",
    "text": "あなたは、休んでいるときも価値のある人だ。",
    "language": "ja"
  },
  {
    "id": 54,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、自分の人生に味方すること。",
    "language": "ja"
  },
  {
    "id": 55,
    "category": "自尊心と自己愛",
    "text": "誰かの期待に届かなくても、自分を見捨てなくていい。",
    "language": "ja"
  },
  {
    "id": 56,
    "category": "自尊心と自己愛",
    "text": "小さな勇気を出した自分を、きちんと褒めてあげよう。",
    "language": "ja"
  },
  {
    "id": 57,
    "category": "自尊心と自己愛",
    "text": "自分の望みを知ることは、自分を尊重する始まりだ。",
    "language": "ja"
  },
  {
    "id": 58,
    "category": "自尊心と自己愛",
    "text": "あなたの存在は、成果や肩書きよりも大きい。",
    "language": "ja"
  },
  {
    "id": 59,
    "category": "自尊心と自己愛",
    "text": "自分を守るために断ることも、誠実な選択の一つだ。",
    "language": "ja"
  },
  {
    "id": 60,
    "category": "自尊心と自己愛",
    "text": "自分を大切にするほど、人との関係にも健やかな余白が生まれる。",
    "language": "ja"
  },
  {
    "id": 61,
    "category": "自尊心と自己愛",
    "text": "自信がない日にも、できることを一つずつ積み重ねよう。",
    "language": "ja"
  },
  {
    "id": 62,
    "category": "自尊心と自己愛",
    "text": "他人の欠点を許すように、自分の不完全さにも余地を与えよう。",
    "language": "ja"
  },
  {
    "id": 63,
    "category": "自尊心と自己愛",
    "text": "自分を好きになるには、まず自分を知ろうとすること。",
    "language": "ja"
  },
  {
    "id": 64,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの人生の脇役ではなく、自分の人生の主人公だ。",
    "language": "ja"
  },
  {
    "id": 65,
    "category": "自尊心と自己愛",
    "text": "自分の気持ちを後回しにすることを、優しさと取り違えないで。",
    "language": "ja"
  },
  {
    "id": 66,
    "category": "自尊心と自己愛",
    "text": "小さな達成を祝うことが、自分への信頼を深める。",
    "language": "ja"
  },
  {
    "id": 67,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、必要なときに助けを求めることでもある。",
    "language": "ja"
  },
  {
    "id": 68,
    "category": "自尊心と自己愛",
    "text": "あなたの価値は、失敗の数で減るものではない。",
    "language": "ja"
  },
  {
    "id": 69,
    "category": "自尊心と自己愛",
    "text": "人と違う道を選ぶことにも、自分らしい意味がある。",
    "language": "ja"
  },
  {
    "id": 70,
    "category": "自尊心と自己愛",
    "text": "自分の本音を聞く時間を、毎日の中に少しつくろう。",
    "language": "ja"
  },
  {
    "id": 71,
    "category": "自尊心と自己愛",
    "text": "自分に厳しいだけでは、成長に必要な力は育たない。",
    "language": "ja"
  },
  {
    "id": 72,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの承認がなくても自分を大切にしていい。",
    "language": "ja"
  },
  {
    "id": 73,
    "category": "自尊心と自己愛",
    "text": "自分の心を大切にすることは、未来の自分への贈り物だ。",
    "language": "ja"
  },
  {
    "id": 74,
    "category": "自尊心と自己愛",
    "text": "できないことがあっても、できることまで忘れないで。",
    "language": "ja"
  },
  {
    "id": 75,
    "category": "自尊心と自己愛",
    "text": "自分を愛する人は、自分の間違いからも学び直せる。",
    "language": "ja"
  },
  {
    "id": 76,
    "category": "自尊心と自己愛",
    "text": "あなたの価値を、ひとつの失敗や一日の気分で決めないで。",
    "language": "ja"
  },
  {
    "id": 77,
    "category": "自尊心と自己愛",
    "text": "自分にとって心地よい選択を知ることも、自信の一部だ。",
    "language": "ja"
  },
  {
    "id": 78,
    "category": "自尊心と自己愛",
    "text": "誰かと比べて落ち込んだら、自分だけの道に目を戻そう。",
    "language": "ja"
  },
  {
    "id": 79,
    "category": "自尊心と自己愛",
    "text": "自分を受け入れることは、成長をあきらめることではない。",
    "language": "ja"
  },
  {
    "id": 80,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かに役立つときだけ存在していい人ではない。",
    "language": "ja"
  },
  {
    "id": 81,
    "category": "自尊心と自己愛",
    "text": "自分の疲れを無視しないことも、自分への敬意だ。",
    "language": "ja"
  },
  {
    "id": 82,
    "category": "自尊心と自己愛",
    "text": "過去の自分を責めるより、今の自分を支える方法を考えよう。",
    "language": "ja"
  },
  {
    "id": 83,
    "category": "自尊心と自己愛",
    "text": "自分の小さな変化に気づくことが、自己信頼を育てる。",
    "language": "ja"
  },
  {
    "id": 84,
    "category": "自尊心と自己愛",
    "text": "あなたは、自分の気持ちを大切にするために理由を証明しなくていい。",
    "language": "ja"
  },
  {
    "id": 85,
    "category": "自尊心と自己愛",
    "text": "自分らしさを隠さずにいられる場所を選ぼう。",
    "language": "ja"
  },
  {
    "id": 86,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、苦手な部分を抱えながらも味方でいること。",
    "language": "ja"
  },
  {
    "id": 87,
    "category": "自尊心と自己愛",
    "text": "他人の成功を見ても、自分の可能性を小さくしなくていい。",
    "language": "ja"
  },
  {
    "id": 88,
    "category": "自尊心と自己愛",
    "text": "自分を尊重する人は、無理な要求にいつも応える必要はないと知っている。",
    "language": "ja"
  },
  {
    "id": 89,
    "category": "自尊心と自己愛",
    "text": "今日できたことを一つ認めるだけでも、自信は育つ。",
    "language": "ja"
  },
  {
    "id": 90,
    "category": "自尊心と自己愛",
    "text": "自分の価値は、誰かの気まぐれな評価に預けなくていい。",
    "language": "ja"
  },
  {
    "id": 91,
    "category": "自尊心と自己愛",
    "text": "あなたには、成長する時間も休む時間も必要だ。",
    "language": "ja"
  },
  {
    "id": 92,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、自分の心身を丁寧に扱うこと。",
    "language": "ja"
  },
  {
    "id": 93,
    "category": "自尊心と自己愛",
    "text": "苦手なことがあるからといって、あなたの魅力が消えるわけではない。",
    "language": "ja"
  },
  {
    "id": 94,
    "category": "自尊心と自己愛",
    "text": "自分の選択に責任を持つことは、自分を信じる練習になる。",
    "language": "ja"
  },
  {
    "id": 95,
    "category": "自尊心と自己愛",
    "text": "自分を否定する声が強い日は、事実と感情を分けてみよう。",
    "language": "ja"
  },
  {
    "id": 96,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの理想どおりでなくても大切な人だ。",
    "language": "ja"
  },
  {
    "id": 97,
    "category": "自尊心と自己愛",
    "text": "自分の歩幅を守ることが、自分らしい未来につながる。",
    "language": "ja"
  },
  {
    "id": 98,
    "category": "自尊心と自己愛",
    "text": "自分を好きになるには、完璧さより理解が必要だ。",
    "language": "ja"
  },
  {
    "id": 99,
    "category": "自尊心と自己愛",
    "text": "自分の気持ちを表現することは、わがままではなく誠実さだ。",
    "language": "ja"
  },
  {
    "id": 100,
    "category": "自尊心と自己愛",
    "text": "あなたは、何かを失敗しても尊重される価値がある。",
    "language": "ja"
  },
  {
    "id": 101,
    "category": "自尊心と自己愛",
    "text": "自分のために時間を使うことを、遠慮しなくていい。",
    "language": "ja"
  },
  {
    "id": 102,
    "category": "自尊心と自己愛",
    "text": "誰かに嫌われる可能性があっても、自分を裏切らなくていい。",
    "language": "ja"
  },
  {
    "id": 103,
    "category": "自尊心と自己愛",
    "text": "自分の良いところを言葉にすると、見え方が少しずつ変わる。",
    "language": "ja"
  },
  {
    "id": 104,
    "category": "自尊心と自己愛",
    "text": "自信は、恐れがなくなることではなく、恐れながらも自分を支えること。",
    "language": "ja"
  },
  {
    "id": 105,
    "category": "自尊心と自己愛",
    "text": "自分の心を守るために距離を置くことも、立派な自己尊重だ。",
    "language": "ja"
  },
  {
    "id": 106,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの期待に応えられない日にも価値がある。",
    "language": "ja"
  },
  {
    "id": 107,
    "category": "自尊心と自己愛",
    "text": "自分の過去を理解することは、未来の自分を責めないための一歩。",
    "language": "ja"
  },
  {
    "id": 108,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする習慣は、小さな選択から始まる。",
    "language": "ja"
  },
  {
    "id": 109,
    "category": "自尊心と自己愛",
    "text": "人と違うことは、間違っていることと同じではない。",
    "language": "ja"
  },
  {
    "id": 110,
    "category": "自尊心と自己愛",
    "text": "あなたは、今の自分から始めても遅くない。",
    "language": "ja"
  },
  {
    "id": 111,
    "category": "自尊心と自己愛",
    "text": "自分の感情を知ることは、自分を大切にするための地図になる。",
    "language": "ja"
  },
  {
    "id": 112,
    "category": "自尊心と自己愛",
    "text": "自分に優しい人ほど、長い道のりを歩き続けやすい。",
    "language": "ja"
  },
  {
    "id": 113,
    "category": "自尊心と自己愛",
    "text": "自分の価値を、他人の機嫌で上下させないで。",
    "language": "ja"
  },
  {
    "id": 114,
    "category": "自尊心と自己愛",
    "text": "あなたは、愛されるために自分を小さくする必要はない。",
    "language": "ja"
  },
  {
    "id": 115,
    "category": "自尊心と自己愛",
    "text": "自分の努力を認めることから、健やかな自信が生まれる。",
    "language": "ja"
  },
  {
    "id": 116,
    "category": "自尊心と自己愛",
    "text": "自分を大切にすることは、苦しい関係に耐え続けることではない。",
    "language": "ja"
  },
  {
    "id": 117,
    "category": "自尊心と自己愛",
    "text": "自分にとって大切なものを知ると、選択に軸が生まれる。",
    "language": "ja"
  },
  {
    "id": 118,
    "category": "自尊心と自己愛",
    "text": "あなたの人生は、他人の期待を満たすためだけにあるのではない。",
    "language": "ja"
  },
  {
    "id": 119,
    "category": "自尊心と自己愛",
    "text": "自分を許すことは、同じ過ちを繰り返すこととは違う。",
    "language": "ja"
  },
  {
    "id": 120,
    "category": "自尊心と自己愛",
    "text": "小さな一歩でも、自分で選んで進んだことに意味がある。",
    "language": "ja"
  },
  {
    "id": 121,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、変わりたい自分も今の自分も大切にすること。",
    "language": "ja"
  },
  {
    "id": 122,
    "category": "自尊心と自己愛",
    "text": "他人の言葉をすべて真実として受け取らなくていい。",
    "language": "ja"
  },
  {
    "id": 123,
    "category": "自尊心と自己愛",
    "text": "あなたの個性を理解してくれる人とのつながりを大切にしよう。",
    "language": "ja"
  },
  {
    "id": 124,
    "category": "自尊心と自己愛",
    "text": "自分を認めることは、他人より優れていると考えることではない。",
    "language": "ja"
  },
  {
    "id": 125,
    "category": "自尊心と自己愛",
    "text": "自分に必要な休息を選ぶことも、自分への信頼を示す行動だ。",
    "language": "ja"
  },
  {
    "id": 126,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの役に立てない日にも大切な存在だ。",
    "language": "ja"
  },
  {
    "id": 127,
    "category": "自尊心と自己愛",
    "text": "自分を責める時間を、自分を理解する時間に変えてみよう。",
    "language": "ja"
  },
  {
    "id": 128,
    "category": "自尊心と自己愛",
    "text": "自分らしい幸せを、他人の基準だけで決めないで。",
    "language": "ja"
  },
  {
    "id": 129,
    "category": "自尊心と自己愛",
    "text": "自分の気持ちを大切にすることから、心の強さが育つ。",
    "language": "ja"
  },
  {
    "id": 130,
    "category": "自尊心と自己愛",
    "text": "あなたは、過去の選択だけで定義される人ではない。",
    "language": "ja"
  },
  {
    "id": 131,
    "category": "自尊心と自己愛",
    "text": "自分の小さな成功を見落とさないで。",
    "language": "ja"
  },
  {
    "id": 132,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、必要な助けを受け取ることでもある。",
    "language": "ja"
  },
  {
    "id": 133,
    "category": "自尊心と自己愛",
    "text": "自分の弱さを認められることは、勇気の一つだ。",
    "language": "ja"
  },
  {
    "id": 134,
    "category": "自尊心と自己愛",
    "text": "他人の歩みを見て焦ったら、自分がここまで来た道を思い出そう。",
    "language": "ja"
  },
  {
    "id": 135,
    "category": "自尊心と自己愛",
    "text": "あなたは、いつでも学び直し、選び直すことができる。",
    "language": "ja"
  },
  {
    "id": 136,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする人は、心の限界を無視しない。",
    "language": "ja"
  },
  {
    "id": 137,
    "category": "自尊心と自己愛",
    "text": "自分の価値を、誰かとの比較から解放しよう。",
    "language": "ja"
  },
  {
    "id": 138,
    "category": "自尊心と自己愛",
    "text": "あなたは、変化の途中にいても十分に尊い存在だ。",
    "language": "ja"
  },
  {
    "id": 139,
    "category": "自尊心と自己愛",
    "text": "自分の希望を口にすることは、自分を尊重する行動だ。",
    "language": "ja"
  },
  {
    "id": 140,
    "category": "自尊心と自己愛",
    "text": "自分に厳しい言葉をかける前に、親友なら何と言うか考えよう。",
    "language": "ja"
  },
  {
    "id": 141,
    "category": "自尊心と自己愛",
    "text": "自分の心を守ることは、未来の可能性を守ることでもある。",
    "language": "ja"
  },
  {
    "id": 142,
    "category": "自尊心と自己愛",
    "text": "あなたは、他人と同じ速さで成長する必要はない。",
    "language": "ja"
  },
  {
    "id": 143,
    "category": "自尊心と自己愛",
    "text": "自分を好きになれない日は、自分を傷つけないことから始めよう。",
    "language": "ja"
  },
  {
    "id": 144,
    "category": "自尊心と自己愛",
    "text": "自分の良さは、誰かに認められるまで存在しないわけではない。",
    "language": "ja"
  },
  {
    "id": 145,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、自分の幸せを真剣に考えること。",
    "language": "ja"
  },
  {
    "id": 146,
    "category": "自尊心と自己愛",
    "text": "小さな約束を自分と守るたび、自分への信頼が育つ。",
    "language": "ja"
  },
  {
    "id": 147,
    "category": "自尊心と自己愛",
    "text": "あなたは、完璧な説明ができなくても気持ちを大切にしていい。",
    "language": "ja"
  },
  {
    "id": 148,
    "category": "自尊心と自己愛",
    "text": "自分の本音に気づくことは、自分らしい人生への入口だ。",
    "language": "ja"
  },
  {
    "id": 149,
    "category": "自尊心と自己愛",
    "text": "自分を責める代わりに、次にできることを一つ探そう。",
    "language": "ja"
  },
  {
    "id": 150,
    "category": "自尊心と自己愛",
    "text": "誰かの期待を裏切っても、自分の心を守る必要があるときがある。",
    "language": "ja"
  },
  {
    "id": 151,
    "category": "自尊心と自己愛",
    "text": "あなたは、失敗を経験しても尊重されるべき人だ。",
    "language": "ja"
  },
  {
    "id": 152,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、疲れた自分に休息を許すこと。",
    "language": "ja"
  },
  {
    "id": 153,
    "category": "自尊心と自己愛",
    "text": "自分の境界線を伝えることは、健やかな関係をつくる一歩だ。",
    "language": "ja"
  },
  {
    "id": 154,
    "category": "自尊心と自己愛",
    "text": "あなたは、すべての人に理解されなくても自分を大切にしていい。",
    "language": "ja"
  },
  {
    "id": 155,
    "category": "自尊心と自己愛",
    "text": "自分の個性を受け入れるほど、他人の個性にも寛容になれる。",
    "language": "ja"
  },
  {
    "id": 156,
    "category": "自尊心と自己愛",
    "text": "自分を大切にすることを、いつかではなく今日始めよう。",
    "language": "ja"
  },
  {
    "id": 157,
    "category": "自尊心と自己愛",
    "text": "あなたの価値は、成果が出ない時期にも失われない。",
    "language": "ja"
  },
  {
    "id": 158,
    "category": "自尊心と自己愛",
    "text": "自分の歩みを認めることは、次の一歩を踏み出す力になる。",
    "language": "ja"
  },
  {
    "id": 159,
    "category": "自尊心と自己愛",
    "text": "自分を愛する人は、失敗しても自分との関係を修復しようとする。",
    "language": "ja"
  },
  {
    "id": 160,
    "category": "自尊心と自己愛",
    "text": "自分の気持ちを言葉にすることは、心を理解する助けになる。",
    "language": "ja"
  },
  {
    "id": 161,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かに選ばれなくても自分の人生を選べる。",
    "language": "ja"
  },
  {
    "id": 162,
    "category": "自尊心と自己愛",
    "text": "自分の幸せを考えることは、他人への思いやりと矛盾しない。",
    "language": "ja"
  },
  {
    "id": 163,
    "category": "自尊心と自己愛",
    "text": "自分のよさを見つける練習を、毎日少しずつ続けよう。",
    "language": "ja"
  },
  {
    "id": 164,
    "category": "自尊心と自己愛",
    "text": "あなたは、今の自分を否定しなくても成長できる。",
    "language": "ja"
  },
  {
    "id": 165,
    "category": "自尊心と自己愛",
    "text": "自分に向ける優しさは、心が弱ったときの支えになる。",
    "language": "ja"
  },
  {
    "id": 166,
    "category": "自尊心と自己愛",
    "text": "他人の評価が変わっても、自分の尊厳まで手放さないで。",
    "language": "ja"
  },
  {
    "id": 167,
    "category": "自尊心と自己愛",
    "text": "自分の人生を選ぶ勇気は、小さな決断から育つ。",
    "language": "ja"
  },
  {
    "id": 168,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かと違うことを理由に自分を恥じなくていい。",
    "language": "ja"
  },
  {
    "id": 169,
    "category": "自尊心と自己愛",
    "text": "自分を尊重することは、自分の時間を大切にすることでもある。",
    "language": "ja"
  },
  {
    "id": 170,
    "category": "自尊心と自己愛",
    "text": "自分の欠点を知ることと、自分を嫌うことは別のことだ。",
    "language": "ja"
  },
  {
    "id": 171,
    "category": "自尊心と自己愛",
    "text": "あなたは、今の自分にも優しさを向ける価値がある。",
    "language": "ja"
  },
  {
    "id": 172,
    "category": "自尊心と自己愛",
    "text": "自分の努力を認めれば、結果だけでは見えない成長に気づける。",
    "language": "ja"
  },
  {
    "id": 173,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、心と体の声を無視しないこと。",
    "language": "ja"
  },
  {
    "id": 174,
    "category": "自尊心と自己愛",
    "text": "あなたの存在は、誰かとの比較を必要としない。",
    "language": "ja"
  },
  {
    "id": 175,
    "category": "自尊心と自己愛",
    "text": "自分を責める癖に気づいたら、少しずつ別の言葉を選ぼう。",
    "language": "ja"
  },
  {
    "id": 176,
    "category": "自尊心と自己愛",
    "text": "自分らしい選択には、他人に説明しきれない価値もある。",
    "language": "ja"
  },
  {
    "id": 177,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの期待に応えるためだけに生きなくていい。",
    "language": "ja"
  },
  {
    "id": 178,
    "category": "自尊心と自己愛",
    "text": "自分を大切にすることは、必要なときに助けを求める強さだ。",
    "language": "ja"
  },
  {
    "id": 179,
    "category": "自尊心と自己愛",
    "text": "自分の心に誠実でいることが、自信の土台になる。",
    "language": "ja"
  },
  {
    "id": 180,
    "category": "自尊心と自己愛",
    "text": "あなたは、まだ成長の途中でも大切な存在だ。",
    "language": "ja"
  },
  {
    "id": 181,
    "category": "自尊心と自己愛",
    "text": "自分のよさを認めることから、自然な自信が育っていく。",
    "language": "ja"
  },
  {
    "id": 182,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、人生の味方であり続けること。",
    "language": "ja"
  },
  {
    "id": 183,
    "category": "自尊心と自己愛",
    "text": "他人の成功を見ても、自分の道を信じる余地は残っている。",
    "language": "ja"
  },
  {
    "id": 184,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの意見だけで自分を定義しなくていい。",
    "language": "ja"
  },
  {
    "id": 185,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする選択を、毎日の小さな習慣にしよう。",
    "language": "ja"
  },
  {
    "id": 186,
    "category": "自尊心と自己愛",
    "text": "自分の気持ちを無視しないことが、自尊心を守る一歩だ。",
    "language": "ja"
  },
  {
    "id": 187,
    "category": "自尊心と自己愛",
    "text": "あなたは、休む日にも成長する日にも同じように価値がある。",
    "language": "ja"
  },
  {
    "id": 188,
    "category": "自尊心と自己愛",
    "text": "自分の人生を、自分の価値観で少しずつ形づくろう。",
    "language": "ja"
  },
  {
    "id": 189,
    "category": "自尊心と自己愛",
    "text": "自分に優しい視点を持つと、失敗から学ぶ余裕が生まれる。",
    "language": "ja"
  },
  {
    "id": 190,
    "category": "自尊心と自己愛",
    "text": "あなたは、過去の自分を責め続けなくても前へ進める。",
    "language": "ja"
  },
  {
    "id": 191,
    "category": "自尊心と自己愛",
    "text": "自分の本音を尊重することは、自分を信じる練習になる。",
    "language": "ja"
  },
  {
    "id": 192,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、欠点のない自分をつくることではない。",
    "language": "ja"
  },
  {
    "id": 193,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かに認めてもらうまで幸せを待たなくていい。",
    "language": "ja"
  },
  {
    "id": 194,
    "category": "自尊心と自己愛",
    "text": "自分の心を大切にするほど、自分に合う道が見えやすくなる。",
    "language": "ja"
  },
  {
    "id": 195,
    "category": "自尊心と自己愛",
    "text": "自分の努力を見逃さず、今日の自分をねぎらおう。",
    "language": "ja"
  },
  {
    "id": 196,
    "category": "自尊心と自己愛",
    "text": "あなたは、何かを達成しなくても休息と尊重に値する。",
    "language": "ja"
  },
  {
    "id": 197,
    "category": "自尊心と自己愛",
    "text": "自分を尊重することは、無理な期待から自分を守ること。",
    "language": "ja"
  },
  {
    "id": 198,
    "category": "自尊心と自己愛",
    "text": "自分らしくいるために、すべての人の理解を得る必要はない。",
    "language": "ja"
  },
  {
    "id": 199,
    "category": "自尊心と自己愛",
    "text": "あなたは、自分の弱さと強さの両方を持つ一人の人だ。",
    "language": "ja"
  },
  {
    "id": 200,
    "category": "自尊心と自己愛",
    "text": "自分を大切にすることから、健やかな自信が始まる。",
    "language": "ja"
  },
  {
    "id": 201,
    "category": "自尊心と自己愛",
    "text": "自分の選択を振り返るとき、責めるより学ぶ姿勢を持とう。",
    "language": "ja"
  },
  {
    "id": 202,
    "category": "自尊心と自己愛",
    "text": "あなたは、昨日より少しでも自分を理解できたなら前進している。",
    "language": "ja"
  },
  {
    "id": 203,
    "category": "自尊心と自己愛",
    "text": "自分の価値を思い出すために、他人の許可はいらない。",
    "language": "ja"
  },
  {
    "id": 204,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、自分の人生に優しい責任を持つこと。",
    "language": "ja"
  },
  {
    "id": 205,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの基準に合わなくても自分らしく輝ける。",
    "language": "ja"
  },
  {
    "id": 206,
    "category": "自尊心と自己愛",
    "text": "自分の心に余白を与えることも、自己尊重の一つだ。",
    "language": "ja"
  },
  {
    "id": 207,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする行動を、後回しにしないで。",
    "language": "ja"
  },
  {
    "id": 208,
    "category": "自尊心と自己愛",
    "text": "あなたは、失敗した日にも大切にされるべき存在だ。",
    "language": "ja"
  },
  {
    "id": 209,
    "category": "自尊心と自己愛",
    "text": "自分の良さを言葉にして、自分自身にも届けよう。",
    "language": "ja"
  },
  {
    "id": 210,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、自分の幸せを選ぶ勇気を持つこと。",
    "language": "ja"
  },
  {
    "id": 211,
    "category": "自尊心と自己愛",
    "text": "他人と比べて見失った自分の魅力を、もう一度探してみよう。",
    "language": "ja"
  },
  {
    "id": 212,
    "category": "自尊心と自己愛",
    "text": "あなたは、自分の気持ちを尊重しながら人を愛することができる。",
    "language": "ja"
  },
  {
    "id": 213,
    "category": "自尊心と自己愛",
    "text": "自分に向ける思いやりを、日々の選択に込めよう。",
    "language": "ja"
  },
  {
    "id": 214,
    "category": "自尊心と自己愛",
    "text": "自分の歩みを信じることは、焦りに流されないための支えだ。",
    "language": "ja"
  },
  {
    "id": 215,
    "category": "自尊心と自己愛",
    "text": "あなたは、今の自分から始めることができる。",
    "language": "ja"
  },
  {
    "id": 216,
    "category": "自尊心と自己愛",
    "text": "自分を否定しない一日も、立派な成長の一日だ。",
    "language": "ja"
  },
  {
    "id": 217,
    "category": "自尊心と自己愛",
    "text": "自分の存在を大切にすることは、人生への敬意でもある。",
    "language": "ja"
  },
  {
    "id": 218,
    "category": "自尊心と自己愛",
    "text": "あなたは、他人の光を認めながら自分の光も守っていい。",
    "language": "ja"
  },
  {
    "id": 219,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、心が疲れたときに自分を置き去りにしないこと。",
    "language": "ja"
  },
  {
    "id": 220,
    "category": "自尊心と自己愛",
    "text": "自分の望みを大切にすることが、自分らしい未来をつくる。",
    "language": "ja"
  },
  {
    "id": 221,
    "category": "自尊心と自己愛",
    "text": "あなたは、完璧でなくても愛情と尊重を受ける価値がある。",
    "language": "ja"
  },
  {
    "id": 222,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする小さな行動を、今日ひとつ選ぼう。",
    "language": "ja"
  },
  {
    "id": 223,
    "category": "自尊心と自己愛",
    "text": "自分の良さを見つける目は、練習するほど育っていく。",
    "language": "ja"
  },
  {
    "id": 224,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの期待に応えられないときも自分の味方でいていい。",
    "language": "ja"
  },
  {
    "id": 225,
    "category": "自尊心と自己愛",
    "text": "自分の心を尊重することは、長く幸せに生きるための基礎だ。",
    "language": "ja"
  },
  {
    "id": 226,
    "category": "自尊心と自己愛",
    "text": "自分を愛するとは、変化を急がず成長を見守ること。",
    "language": "ja"
  },
  {
    "id": 227,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かの評価より深い価値を持っている。",
    "language": "ja"
  },
  {
    "id": 228,
    "category": "自尊心と自己愛",
    "text": "自分を信じる気持ちは、小さな行動の積み重ねで育つ。",
    "language": "ja"
  },
  {
    "id": 229,
    "category": "自尊心と自己愛",
    "text": "自分を大切にすることを、今日の自分に許してあげよう。",
    "language": "ja"
  },
  {
    "id": 230,
    "category": "自尊心と自己愛",
    "text": "あなたは、過去の失敗よりも大きな可能性を持っている。",
    "language": "ja"
  },
  {
    "id": 231,
    "category": "自尊心と自己愛",
    "text": "自分らしさを尊重することが、自分への愛を育てる。",
    "language": "ja"
  },
  {
    "id": 232,
    "category": "自尊心と自己愛",
    "text": "自分の心に優しく向き合うことから、明日への力が生まれる。",
    "language": "ja"
  },
  {
    "id": 233,
    "category": "自尊心と自己愛",
    "text": "あなたは、今の自分にも未来の自分にも味方でいていい。",
    "language": "ja"
  },
  {
    "id": 234,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、人生のどんな時期にも自分を見捨てないこと。",
    "language": "ja"
  },
  {
    "id": 235,
    "category": "自尊心と自己愛",
    "text": "自分の価値を忘れた日は、自分が乗り越えてきたことを思い出そう。",
    "language": "ja"
  },
  {
    "id": 236,
    "category": "自尊心と自己愛",
    "text": "あなたは、誰かと違うからこそ持っている魅力がある。",
    "language": "ja"
  },
  {
    "id": 237,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする選択は、小さくても未来を変えていく。",
    "language": "ja"
  },
  {
    "id": 238,
    "category": "自尊心と自己愛",
    "text": "自分を愛することは、自分の気持ちと可能性を尊重すること。",
    "language": "ja"
  },
  {
    "id": 239,
    "category": "自尊心と自己愛",
    "text": "あなたは、今日ここにいるだけでも大切な存在だ。",
    "language": "ja"
  },
  {
    "id": 240,
    "category": "自尊心と自己愛",
    "text": "自分の歩みを認めながら、自分らしい明日を選んでいこう。",
    "language": "ja"
  },
  {
    "id": 241,
    "category": "自尊心と自己愛",
    "text": "自分を大切にする小さな選択を、今日も一つ重ねよう。自分への信頼は少しずつ育っていく。(1)",
    "language": "ja"
  },
