<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery preview — keep light (no large character bitmaps). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="@drawable/dday_widget_duo_frame"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dday_widget_label"
            android:textColor="#F26B8A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="오늘도 화이팅!"
            android:textColor="#3A3F4A"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
