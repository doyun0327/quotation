<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dday_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Solo -->
    <LinearLayout
        android:id="@+id/dday_solo_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dday_widget_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="visible"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/dday_solo_me"
            android:layout_width="88dp"
            android:layout_height="116dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/character" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dday_solo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#2C3340"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="내 생일" />

            <TextView
                android:id="@+id/dday_solo_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E85A7A"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="D-15" />

            <TextView
                android:id="@+id/dday_solo_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8A93A3"
                android:textSize="11sp"
                tools:text="2026. 11. 03 (화)" />
        </LinearLayout>
    </LinearLayout>

    <!-- Duo: free-move characters over sky + grass -->
    <LinearLayout
        android:id="@+id/dday_duo_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dday_widget_duo_frame"
        android:clipChildren="false"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/dday_duo_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFF3E8"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/dday_duo_card_wrap"
                android:layout_width="132dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/dday_widget_card_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/dday_duo_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#3A3F4A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="내 생일" />

                <TextView
                    android:id="@+id/dday_duo_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:textColor="#F26B8A"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="D-15" />

                <TextView
                    android:id="@+id/dday_duo_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#9AA3B2"
                    android:textSize="10sp"
                    tools:text="2026. 11. 03 (화)" />
            </LinearLayout>

            <ImageView
                android:id="@+id/dday_duo_heart"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:layout_marginEnd="78dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/dday_duo_me"
                android:layout_width="112dp"
                android:layout_height="148dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/character" />

            <ImageView
                android:id="@+id/dday_duo_friend"
                android:layout_width="112dp"
                android:layout_height="148dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/character_bul" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="#CDE9C4">

            <TextView
                android:id="@+id/dday_duo_flower_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="16dp"
                android:text="✿"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/dday_duo_flower_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="❀"
                android:textColor="#FFD0DC"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/dday_duo_flower_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="18dp"
                android:text="✿"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
