<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘의 말 · medium in the picker (iOS systemMedium, 4×2, fixed like
     iPhone). 300×150dp maps to 4×2; 250dp is read as 3 cells. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/daily_word_widget"
    android:minWidth="300dp"
    android:minHeight="150dp"
    android:minResizeWidth="300dp"
    android:minResizeHeight="150dp"
    android:maxResizeWidth="300dp"
    android:maxResizeHeight="150dp"
    android:previewLayout="@layout/daily_word_widget_preview_medium"
    android:resizeMode="none"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="hide_from_picker" />
