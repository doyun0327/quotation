rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /ddays/{ddayId} {
      // Shared test room: any signed-in device (including anonymous) can join.
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // Owner edits content; guests may bump status/memberCount on accept.
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || request.auth.uid == request.resource.data.ownerUid
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'memberCount', 'updatedAt']));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /dday_invites/{inviteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.hostUid == request.auth.uid
            || resource.data.status == 'pending');
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /dday_memberships/{ddayId} {
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';

      function isRoomMember() {
        return resource.data.hostUid == request.auth.uid
            || request.auth.uid in resource.data.guestUids;
      }

      // Allow get on missing docs so hosts can create membership before cheers.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/dday_memberships/$(ddayId))
        || isRoomMember()
      );
      allow list: if signedIn() && isRoomMember();

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && request.resource.data.guestUids is list;
      allow update: if signedIn()
        && isRoomMember()
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
