rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    match /ddays/{ddayId} {
      // Shared test room: any signed-in device (including anonymous) can join.
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // Owner edits content; guests may bump status/memberCount on accept.
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || request.auth.uid == request.resource.data.ownerUid
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'memberCount', 'updatedAt']));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /dday_invites/{inviteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.hostUid == request.auth.uid
            || resource.data.status == 'pending');
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /dday_memberships/{ddayId} {
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';

      function isHost() {
        return resource.data.hostUid == request.auth.uid;
      }

      function isGuest() {
        return resource.data.keys().hasAll(['guestUids'])
            && request.auth.uid in resource.data.guestUids;
      }

      function isRoomMember() {
        return isHost() || isGuest();
      }

      // A friend with the invite code adds only themselves. The room must be open.
      function isJoiningSelf() {
        return resource.data.inviteOpen == true
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUids is list
            && request.auth.uid in request.resource.data.guestUids
            && !isGuest()
            && request.resource.data.members is list
            && resource.data.members is list
            && request.resource.data.members.size() == resource.data.members.size() + 1
            // members are guests only, so 9 guests + host = 10 people.
            && request.resource.data.members.size() <= 9;
      }

      // Join transaction must read the room before the friend is a member.
      allow get: if signedIn();
      allow list: if signedIn() && isRoomMember();

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.guestUids is list;
      allow update: if signedIn() && (isRoomMember() || isJoiningSelf());
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /content_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && request.resource.data.roomId.size() < 200
        && request.resource.data.reason in ['harassment', 'sexual', 'spam', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.contentText is string
        && request.resource.data.contentText.size() <= 500
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.targetUid is string
        && request.resource.data.targetName is string
        && request.resource.data.blockRequested is bool;
      allow read, update, delete: if false;
    }
  }
}
