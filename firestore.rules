rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Private: email and push tokens. Cloud Functions use the Admin SDK and
    // are not bound by these rules. It used to be readable, and listable, by
    // any signed-in account, anonymous ones included, which exposed every
    // user's email.
    //
    // TRANSITION: app versions before the `profiles` split read a friend's
    // nickname with a single get of users/{uid} while accepting an invite.
    // Single gets stay open until those versions are gone; listing (the bulk
    // email leak) is closed now. Later, replace the two lines below with
    // `allow read: if isSelf(uid);`.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    // Public: what friends see (nickname, main character). One doc at a time
    // by uid; no listing, so nobody can collect the whole user base.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'characterId', 'updatedAt'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40))
        && (!('characterId' in request.resource.data)
            || (request.resource.data.characterId is string
                && request.resource.data.characterId.size() <= 40));
      allow delete: if isSelf(uid);
    }

    match /ddays/{ddayId} {
      // Shared test room: any signed-in device (including anonymous) can join.
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // Owner edits content; guests may bump status/memberCount on accept.
      // Taking over ownerUid needs the room behind it: only whoever its
      // membership names as host may become owner (an Apple account switch
      // claims the membership first, see isHandoffClaim). Writing your own
      // uid used to be enough, which let anyone take any D-day.
      function roomHostIsMe() {
        return exists(/databases/$(database)/documents/dday_memberships/$(ddayId))
          && get(/databases/$(database)/documents/dday_memberships/$(ddayId))
              .data.hostUid == request.auth.uid;
      }
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || (request.resource.data.ownerUid == request.auth.uid
                && roomHostIsMe())
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'memberCount', 'updatedAt']));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /dday_invites/{inviteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.hostUid == request.auth.uid
            || resource.data.status == 'pending');
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /dday_memberships/{ddayId} {
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';

      function isHost() {
        return resource.data.hostUid == request.auth.uid;
      }

      function isGuest() {
        return request.auth.uid in resource.data.get('guestUids', []);
      }

      function isRoomMember() {
        return isHost() || isGuest();
      }

      // A friend with the invite code adds only themselves. The room must be open.
      function isJoiningSelf() {
        return resource.data.inviteOpen == true
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUids is list
            && request.auth.uid in request.resource.data.guestUids
            && !isGuest()
            && request.resource.data.members is list
            && resource.data.members is list
            && request.resource.data.members.size() == resource.data.members.size() + 1
            // Joining adds only you: everyone else's entry (character) and
            // the host's character stay exactly as they were.
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.get('hostCharacterId', null)
                == resource.data.get('hostCharacterId', null)
            // members are guests only, so 9 guests + host = 10 people.
            && request.resource.data.members.size() <= 9;
      }

      // After an Apple sign-in switches accounts, the new account takes over
      // the rooms the old anonymous account left a key on
      // (AccountMigration.leaveHandoffs). It proves the key against the
      // stored sha256 and must remove the handoff in the same write, so each
      // key works once.
      function isHandoffClaim() {
        return resource.data.get('handoff', null) is map
            && request.resource.data.get('handoffKey', null) is string
            && hashing.sha256(request.resource.data.handoffKey).toHexString().lower()
                == resource.data.handoff.keyHash
            && !('handoff' in request.resource.data);
      }

      // Join transaction must read the room before the friend is a member.
      allow get: if signedIn();
      allow list: if signedIn() && isRoomMember();

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.guestUids is list;
      // hostUid moves only by the host (Google account switch) or a handoff
      // claim (Apple). A guest rewriting it would make themselves host, and
      // through roomHostIsMe owner of the D-day as well.
      function keepsHost() {
        return request.resource.data.get('hostUid', null)
            == resource.data.get('hostUid', null);
      }
      // Each person's character (and nickname) lives in their own members[]
      // entry, the host's in hostCharacterId. Only you may change your own:
      // at most your entry is added/replaced/removed. The host may also drop
      // one other entry, which happens when they leave and hand the room to
      // the next friend. Layout fields (positions, bubbles) stay shared.
      function charactersKept() {
        let before = resource.data.get('members', []);
        let after = request.resource.data.get('members', []);
        let added = after.removeAll(before);
        let removed = before.removeAll(after);
        let me = request.auth.uid;
        // Account switch (Google, AccountMigration.moveRooms): the anonymous
        // me hands my own entry to the new uid. Only the uid may differ, so
        // nobody's character changes.
        let movedMine = added.size() == 1 && removed.size() == 1
            && removed[0].get('uid', '') == me
            && added[0].diff(removed[0]).affectedKeys().hasOnly(['uid']);
        return (added.size() == 0
                || (added.size() == 1 && added[0].get('uid', '') == me)
                || movedMine)
            && (removed.size() == 0
                || (removed.size() == 1
                    && (removed[0].get('uid', '') == me || isHost())))
            && (isHost()
                || request.resource.data.get('hostCharacterId', null)
                    == resource.data.get('hostCharacterId', null));
      }
      allow update: if signedIn()
        && ((isRoomMember() && (keepsHost() || isHost()) && charactersKept())
            || isJoiningSelf()
            || isHandoffClaim());
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /content_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && request.resource.data.roomId.size() < 200
        && request.resource.data.reason in ['harassment', 'sexual', 'spam', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.contentText is string
        && request.resource.data.contentText.size() <= 500
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.targetUid is string
        && request.resource.data.targetName is string
        && request.resource.data.blockRequested is bool;
      allow read, update, delete: if false;
    }
  }
}
