rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Private: email and push tokens. Cloud Functions use the Admin SDK and
    // are not bound by these rules. It used to be readable, and listable, by
    // any signed-in account, anonymous ones included, which exposed every
    // user's email.
    //
    // Only the owner reads it now. App versions before the `profiles` split
    // read a friend's nickname here while accepting an invite; they now fall
    // back to the saved nickname.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    // Public: what friends see (nickname, main character). One doc at a time
    // by uid; no listing, so nobody can collect the whole user base.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'characterId', 'updatedAt'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40))
        && (!('characterId' in request.resource.data)
            || (request.resource.data.characterId is string
                && request.resource.data.characterId.size() <= 40));
      allow delete: if isSelf(uid);
    }

    match /ddays/{ddayId} {
      // Shared test room: any signed-in device (including anonymous) can join.
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';
      // The room's owner and members; anyone else only while the room is
      // open to invite codes (a friend joining reads it first). Listing was
      // open to every signed-in account, which exposed every room's title
      // and date. A missing room may be read (the join checks for it).
      function roomReadable() {
        let memPath = /databases/$(database)/documents/dday_memberships/$(ddayId);
        return resource == null
          || resource.data.get('ownerUid', null) == request.auth.uid
          || (exists(memPath)
              && (get(memPath).data.get('hostUid', null) == request.auth.uid
                  || request.auth.uid in get(memPath).data.get('guestUids', [])
                  || get(memPath).data.get('inviteOpen', false) == true));
      }
      allow get: if signedIn() && roomReadable();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // Owner edits content; guests may bump status/memberCount on accept.
      // Taking over ownerUid needs the room behind it: only whoever its
      // membership names as host may become owner (an Apple account switch
      // claims the membership first, see isHandoffClaim). Writing your own
      // uid used to be enough, which let anyone take any D-day.
      function roomHostIsMe() {
        return exists(/databases/$(database)/documents/dday_memberships/$(ddayId))
          && get(/databases/$(database)/documents/dday_memberships/$(ddayId))
              .data.hostUid == request.auth.uid;
      }
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || (request.resource.data.ownerUid == request.auth.uid
                && roomHostIsMe())
            || (roomReadable()
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'memberCount', 'updatedAt'])));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /dday_invites/{inviteId} {
      // Small queries only: a code lookup (limit 3-5), or a friend finding the
      // room's open code by its host (limit 5; app versions before 1.0.20 ask
      // for 40). The whole collection used to be listable, handing out every
      // invited room's id.
      allow get: if signedIn();
      allow list: if signedIn()
        && (resource.data.hostUid == request.auth.uid
            || request.query.limit <= 40);
      // The host, or a friend already in the room. A friend's code still
      // names the room's real host (joining is checked against it) and
      // records who made it in createdBy.
      function friendInvites() {
        let room = get(/databases/$(database)/documents/dday_memberships/$(request.resource.data.ddayId)).data;
        return request.resource.data.get('createdBy', null) == request.auth.uid
          && request.auth.uid in room.get('guestUids', [])
          && room.hostUid == request.resource.data.hostUid;
      }
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && (request.resource.data.hostUid == request.auth.uid
            || friendInvites());
      allow update: if signedIn()
        && (resource.data.hostUid == request.auth.uid
            || resource.data.status == 'pending');
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /dday_memberships/{ddayId} {
      allow read, create, update: if signedIn() && ddayId == 'together-test-room';

      function isHost() {
        return resource.data.hostUid == request.auth.uid;
      }

      function isGuest() {
        return request.auth.uid in resource.data.get('guestUids', []);
      }

      function isRoomMember() {
        return isHost() || isGuest();
      }

      // A friend with the invite code adds only themselves. The room must be open.
      function isJoiningSelf() {
        return resource.data.inviteOpen == true
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUids is list
            && request.auth.uid in request.resource.data.guestUids
            && !isGuest()
            && request.resource.data.members is list
            && resource.data.members is list
            && request.resource.data.members.size() == resource.data.members.size() + 1
            // Joining adds only you: everyone else's entry (character) and
            // the host's character stay exactly as they were.
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.get('hostCharacterId', null)
                == resource.data.get('hostCharacterId', null)
            // members are guests only, so 9 guests + host = 10 people.
            && request.resource.data.members.size() <= 9;
      }

      // After an Apple sign-in switches accounts, the new account takes over
      // the rooms the old anonymous account left a key on
      // (AccountMigration.leaveHandoffs). It proves the key against the
      // stored sha256 and must remove the handoff in the same write, so each
      // key works once.
      function isHandoffClaim() {
        return resource.data.get('handoff', null) is map
            && request.resource.data.get('handoffKey', null) is string
            && hashing.sha256(request.resource.data.handoffKey).toHexString().lower()
                == resource.data.handoff.keyHash
            && !('handoff' in request.resource.data);
      }

      // Members read their room. Anyone else only while it is open to invite
      // codes (the join transaction reads it before the friend is a member)
      // or holds an account-switch handoff (claimed by the new account). It
      // used to be readable by every signed-in account. A missing room may
      // be read: creating one checks first.
      allow get: if signedIn()
        && (resource == null
            || isRoomMember()
            || resource.data.get('inviteOpen', false) == true
            || resource.data.get('handoff', null) != null);
      allow list: if signedIn() && isRoomMember();

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.guestUids is list;
      // hostUid moves only by the host (Google account switch) or a handoff
      // claim (Apple). A guest rewriting it would make themselves host, and
      // through roomHostIsMe owner of the D-day as well.
      function keepsHost() {
        return request.resource.data.get('hostUid', null)
            == resource.data.get('hostUid', null);
      }
      // Each person's character (and nickname) lives in their own members[]
      // entry, the host's in hostCharacterId. Only you may change your own:
      // at most your entry is added/replaced/removed. The host may also drop
      // one other entry, which happens when they leave and hand the room to
      // the next friend. Layout fields (positions, bubbles) stay shared.
      function charactersKept() {
        let before = resource.data.get('members', []);
        let after = request.resource.data.get('members', []);
        let added = after.removeAll(before);
        let removed = before.removeAll(after);
        let me = request.auth.uid;
        // Account switch (Google, AccountMigration.moveRooms): the anonymous
        // me hands my own entry to the new uid. Only the uid may differ, so
        // nobody's character changes.
        let movedMine = added.size() == 1 && removed.size() == 1
            && removed[0].get('uid', '') == me
            && added[0].diff(removed[0]).affectedKeys().hasOnly(['uid']);
        return (added.size() == 0
                || (added.size() == 1 && added[0].get('uid', '') == me)
                || movedMine)
            && (removed.size() == 0
                || (removed.size() == 1
                    && (removed[0].get('uid', '') == me || isHost())))
            && (isHost()
                || request.resource.data.get('hostCharacterId', null)
                    == resource.data.get('hostCharacterId', null));
      }
      // The widget picture a member links (widgetCardId) must be one they
      // saved for this room: no pointing friends at another room's picture,
      // or making the Cloud Function delete it as "replaced".
      function widgetCardKept() {
        let id = request.resource.data.get('widgetCardId', null);
        return id == resource.data.get('widgetCardId', null)
          || (id is string
              && get(/databases/$(database)/documents/widget_cards/$(id)).data.roomId == ddayId
              && get(/databases/$(database)/documents/widget_cards/$(id)).data.by == request.auth.uid);
      }
      allow update: if signedIn()
        && widgetCardKept()
        && ((isRoomMember() && (keepsHost() || isHost()) && charactersKept())
            || isJoiningSelf()
            || isHandoffClaim());
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    // Widget cards: the picture of a room's Together widget, written by the
    // member who edited it, so friends' iPhones can redraw the widget from
    // the notice (notification service extension) without opening the app.
    // The id is random and only travels in the push to the room's members;
    // a get by that id stays open because the extension cannot sign in.
    // Old cards are removed by the Cloud Function (Admin SDK).
    match /widget_cards/{cardId} {
      function memberOf(roomId) {
        let room = get(/databases/$(database)/documents/dday_memberships/$(roomId)).data;
        return room.hostUid == request.auth.uid
          || request.auth.uid in room.get('guestUids', []);
      }
      allow get: if true;
      allow list: if false;
      // `expireAt` carries a TTL (firestore.indexes.json): every card goes
      // within about a week. It must be at most 8 days out, so nobody keeps
      // a card around forever.
      allow create: if signedIn()
        && cardId.matches('^[0-9a-f]{40}$')
        && request.resource.data.keys().hasOnly(['roomId', 'by', 'card', 'at', 'expireAt'])
        && request.resource.data.at == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt < request.time + duration.value(8, 'd')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.card is bytes
        && request.resource.data.card.size() <= 900000
        && memberOf(request.resource.data.roomId);
      allow update, delete: if false;
    }

    match /content_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && request.resource.data.roomId.size() < 200
        && request.resource.data.reason in ['harassment', 'sexual', 'spam', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.contentText is string
        && request.resource.data.contentText.size() <= 500
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.targetUid is string
        && request.resource.data.targetName is string
        && request.resource.data.blockRequested is bool;
      allow read, update, delete: if false;
    }
  }
}
